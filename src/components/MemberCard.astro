---
import type { Member } from "../data/types";
interface Props { memberZh: Member; memberEn: Member; collapsibleBio?: boolean; }
const { memberZh, memberEn, collapsibleBio = false } = Astro.props;
const personalPageLink = memberZh.links.personal_page || memberZh.links.homepage;
const scholarLink = memberZh.links.scholar || memberZh.links.google_scholar;
---
<article class="member reveal">
  <span class="card-hover-ring" aria-hidden="true"></span>
  <div class="member-portrait" aria-hidden="true">
    <div class="member-portrait-frame"></div>
    <div class="member-portrait-glow"></div>
    <div class="member-avatar">
      {memberZh.avatar
        ? <img src={memberZh.avatar} alt="" />
        : <span class="member-monogram">{memberZh.monogram}</span>
      }
    </div>
  </div>
  <div class="member-info">
    <h3 class="member-name">
      <span data-lang="zh">{memberZh.name}</span><span data-lang="en">{memberEn.name}</span>
    </h3>
    <p class="member-role">
      <span class="member-role-dot" aria-hidden="true"></span>
      <span data-lang="zh">{memberZh.role}</span><span data-lang="en">{memberEn.role}</span>
    </p>
    <p class="member-aff">
      <span data-lang="zh">{memberZh.affiliation}</span><span data-lang="en">{memberEn.affiliation}</span>
    </p>
    {collapsibleBio && (memberZh.bio || memberZh.wechatQr) ? (
      <details class="member-bio-details">
        <summary class="member-bio-toggle">
          <span class="member-expand-label"><span data-lang="zh">展开</span><span data-lang="en">Expand</span></span>
          <span class="member-collapse-label"><span data-lang="zh">收起</span><span data-lang="en">Collapse</span></span>
        </summary>
        {memberZh.bio && (
          <>
            <hr class="member-rule" aria-hidden="true" />
            <p class="member-bio">
              <span data-lang="zh">{memberZh.bio}</span><span data-lang="en">{memberEn.bio}</span>
            </p>
          </>
        )}
        {memberZh.wechatQr && (
          <figure class="member-wechat">
            <img src={memberZh.wechatQr} alt={`${memberZh.name} 微信二维码`} loading="lazy" />
            <figcaption>
              <span data-lang="zh">微信二维码</span><span data-lang="en">WeChat QR</span>
            </figcaption>
          </figure>
        )}
      </details>
    ) : memberZh.bio && (
      <>
        <hr class="member-rule" aria-hidden="true" />
        <p class="member-bio">
          <span data-lang="zh">{memberZh.bio}</span><span data-lang="en">{memberEn.bio}</span>
        </p>
      </>
    )}
    {!collapsibleBio && memberZh.wechatQr && (
      <figure class="member-wechat">
        <img src={memberZh.wechatQr} alt={`${memberZh.name} 微信二维码`} loading="lazy" />
        <figcaption>
          <span data-lang="zh">微信二维码</span><span data-lang="en">WeChat QR</span>
        </figcaption>
      </figure>
    )}
    {(personalPageLink || memberZh.links.github || scholarLink || memberZh.links.email) && (
      <div class="member-links">
        {personalPageLink && (
          <a class="member-link" href={personalPageLink} target="_blank" rel="noreferrer"><span data-lang="zh">个人主页</span><span data-lang="en">Personal</span></a>
        )}
        {memberZh.links.github && (
          <a class="member-link" href={memberZh.links.github} target="_blank" rel="noreferrer"><span data-lang="zh">代码仓库</span><span data-lang="en">GitHub</span></a>
        )}
        {scholarLink && (
          <a class="member-link member-link--scholar" href={scholarLink} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
              <path d="M12 2L1 8l11 6 9-4.91V17h2V8L12 2zm-7 9.2v4.7c0 1.66 3.13 3 7 3s7-1.34 7-3v-4.7l-7 3.83-7-3.83z" fill="currentColor"></path>
            </svg>
            <span data-lang="zh">学术主页</span><span data-lang="en">Scholar</span>
          </a>
        )}
        {memberZh.links.email && (
          <a class="member-link" href={`mailto:${memberZh.links.email}`}><span data-lang="zh">电子邮件</span><span data-lang="en">Email</span></a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .member {
    position: relative;
    text-align: center;
    padding: 28px 22px 24px;
    background:
      radial-gradient(120% 120% at 50% 0%, rgba(136, 174, 198, 0.05), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 44, 0.86) 0%, rgba(7, 21, 33, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
  }
  .member::before {
    content: "";
    position: absolute;
    top: 14px; left: 14px;
    width: 14px; height: 14px;
    border-top: 1px solid rgba(175, 204, 220, 0.36);
    border-left: 1px solid rgba(175, 204, 220, 0.36);
    opacity: 0.55;
  }
  .member::after {
    content: "";
    position: absolute;
    bottom: 14px; right: 14px;
    width: 14px; height: 14px;
    border-bottom: 1px solid rgba(175, 204, 220, 0.36);
    border-right: 1px solid rgba(175, 204, 220, 0.36);
    opacity: 0.55;
  }
  .member:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  /* Portrait: hexagonal-feeling round frame with rotating accent ring */
  .member-portrait {
    position: relative;
    width: 92px;
    height: 92px;
    margin: 2px auto 18px;
  }
  .member-portrait-frame {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1.5px;
    background: conic-gradient(from 200deg, transparent 0%, rgba(47, 213, 198, 0.68) 20%, transparent 35%, rgba(225, 234, 47, 0.44) 60%, transparent 80%, rgba(2, 164, 218, 0.68) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    filter: drop-shadow(0 0 8px rgba(47, 213, 198, 0.22));
    animation: member-ring-spin 22s linear infinite;
  }
  .member-portrait-glow {
    position: absolute;
    inset: -18%;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(161, 196, 218, 0.12) 0%, transparent 70%);
    filter: blur(14px);
  }
  .member-avatar {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(170, 202, 220, 0.82), rgba(84, 113, 135, 0.92));
    overflow: hidden;
  }
  .member-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .member-monogram {
    font-family: var(--font-mono);
    font-size: var(--type-medium);
    font-weight: 700;
    color: #06090F;
    letter-spacing: 0.02em;
  }
  @keyframes member-ring-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .member-portrait-frame { animation: none; } }

  .member-info { display: flex; flex-direction: column; align-items: center; }
  .member-name { margin-bottom: 8px; font-size: var(--type-medium); letter-spacing: 0.02em; }
  .member-role {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(182, 212, 229, 0.84);
    margin-bottom: 6px;
  }
  .member-role-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(182, 212, 229, 0.8);
    box-shadow: 0 0 8px rgba(133, 170, 193, 0.28);
  }
  .member-aff { font-size: var(--type-small); color: var(--text-primary); opacity: 0.78; white-space: pre-line; }
  .member-bio-details { width: 100%; margin-top: 14px; }
  .member-bio-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: max-content;
    margin-inline: auto;
    padding: 6px 14px;
    border: 1px solid var(--surface-border-strong);
    border-radius: var(--radius-pill);
    background: rgba(118, 177, 209, 0.1);
    color: var(--accent-cyan);
    font-size: var(--type-small);
    cursor: pointer;
    list-style: none;
  }
  .member-bio-toggle::-webkit-details-marker { display: none; }
  .member-bio-toggle::after {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 180ms ease;
  }
  .member-bio-details[open] .member-expand-label,
  .member-bio-details:not([open]) .member-collapse-label { display: none; }
  .member-bio-details[open] .member-bio-toggle::after { transform: rotate(225deg) translateY(-2px); }
  .member-bio-toggle:focus-visible { outline: 2px solid var(--accent-cyan); outline-offset: 3px; }
  .member-bio-details .member-rule { margin: 16px auto 12px; }
  .member-rule {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(179, 208, 224, 0.42), transparent);
    border: 0;
    margin: 16px 0 12px;
  }
  .member-bio { font-size: var(--type-small); color: rgba(214, 229, 241, 0.72); line-height: 1.7; }
  html[lang="en"] .member-bio { line-height: 1.55; }
  .member-wechat {
    width: min(148px, 100%);
    margin: 16px auto 0;
    padding: 10px 10px 8px;
    border: 1px solid rgba(139, 178, 203, 0.12);
    border-radius: 12px;
    background: rgba(230, 238, 243, 0.04);
  }
  .member-wechat img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
  }
  .member-wechat figcaption {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(206, 220, 229, 0.68);
  }
  .member-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .member-link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(139, 178, 203, 0.11);
    color: rgba(206, 220, 229, 0.74);
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .member-link--scholar { gap: 5px; }
  .member-link--scholar svg { flex: 0 0 15px; }
  .member-link:hover {
    border-color: rgba(181, 209, 224, 0.22);
    color: rgba(228, 236, 241, 0.88);
    background: rgba(158, 181, 196, 0.06);
  }
</style>
