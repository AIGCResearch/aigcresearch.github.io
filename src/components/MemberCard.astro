---
import type { Member } from "../data/types";
interface Props { memberZh: Member; memberEn: Member; }
const { memberZh, memberEn } = Astro.props;
const scholarLink = memberZh.links.scholar || memberZh.links.google_scholar;
---
<article class="member reveal">
  <div class="member-portrait" aria-hidden="true">
    <div class="member-portrait-frame"></div>
    <div class="member-portrait-glow"></div>
    <div class="member-avatar">
      {memberZh.avatar
        ? <img src={memberZh.avatar} alt="" />
        : <span class="member-monogram">{memberZh.monogram}</span>
      }
    </div>
  </div>
  <div class="member-info">
    <h3 class="member-name">
      <span data-lang="zh">{memberZh.name}</span><span data-lang="en">{memberEn.name}</span>
    </h3>
    <p class="member-role">
      <span class="member-role-dot" aria-hidden="true"></span>
      <span data-lang="zh">{memberZh.role}</span><span data-lang="en">{memberEn.role}</span>
    </p>
    <p class="member-aff">
      <span data-lang="zh">{memberZh.affiliation}</span><span data-lang="en">{memberEn.affiliation}</span>
    </p>
    <hr class="member-rule" aria-hidden="true" />
    <p class="member-bio">
      <span data-lang="zh">{memberZh.bio}</span><span data-lang="en">{memberEn.bio}</span>
    </p>
    {(memberZh.links.homepage || memberZh.links.github || scholarLink || memberZh.links.email) && (
      <div class="member-links">
        {memberZh.links.homepage && (
          <a class="member-link" href={memberZh.links.homepage} target="_blank" rel="noreferrer">Home</a>
        )}
        {memberZh.links.github && (
          <a class="member-link" href={memberZh.links.github} target="_blank" rel="noreferrer">GitHub</a>
        )}
        {scholarLink && (
          <a class="member-link" href={scholarLink} target="_blank" rel="noreferrer">Scholar</a>
        )}
        {memberZh.links.email && (
          <a class="member-link" href={`mailto:${memberZh.links.email}`}>Email</a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .member {
    position: relative;
    text-align: center;
    padding: 28px 22px 24px;
    background:
      radial-gradient(120% 120% at 50% 0%, rgba(136, 174, 198, 0.05), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 44, 0.86) 0%, rgba(7, 21, 33, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
  }
  .member::before {
    content: "";
    position: absolute;
    top: 14px; left: 14px;
    width: 14px; height: 14px;
    border-top: 1px solid rgba(175, 204, 220, 0.36);
    border-left: 1px solid rgba(175, 204, 220, 0.36);
    opacity: 0.55;
  }
  .member::after {
    content: "";
    position: absolute;
    bottom: 14px; right: 14px;
    width: 14px; height: 14px;
    border-bottom: 1px solid rgba(175, 204, 220, 0.36);
    border-right: 1px solid rgba(175, 204, 220, 0.36);
    opacity: 0.55;
  }
  .member:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  /* Portrait: hexagonal-feeling round frame with rotating accent ring */
  .member-portrait {
    position: relative;
    width: 92px;
    height: 92px;
    margin: 2px auto 18px;
  }
  .member-portrait-frame {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 1.5px;
    background: conic-gradient(from 200deg, transparent 0%, rgba(171, 202, 220, 0.68) 20%, transparent 35%, rgba(130, 159, 178, 0.44) 60%, transparent 80%, rgba(171, 202, 220, 0.68) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    filter: drop-shadow(0 0 8px rgba(133, 170, 193, 0.22));
    animation: member-ring-spin 22s linear infinite;
  }
  .member-portrait-glow {
    position: absolute;
    inset: -18%;
    border-radius: 50%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(161, 196, 218, 0.12) 0%, transparent 70%);
    filter: blur(14px);
  }
  .member-avatar {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(170, 202, 220, 0.82), rgba(84, 113, 135, 0.92));
    overflow: hidden;
  }
  .member-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .member-monogram {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
    color: #06090F;
    letter-spacing: 0.02em;
  }
  @keyframes member-ring-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .member-portrait-frame { animation: none; } }

  .member-info { display: flex; flex-direction: column; align-items: center; }
  .member-name { margin-bottom: 8px; font-size: 18px; letter-spacing: 0.02em; }
  .member-role {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(182, 212, 229, 0.84);
    margin-bottom: 6px;
  }
  .member-role-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(182, 212, 229, 0.8);
    box-shadow: 0 0 8px rgba(133, 170, 193, 0.28);
  }
  .member-aff { font-size: 12px; color: var(--text-primary); opacity: 0.78; }
  .member-rule {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(179, 208, 224, 0.42), transparent);
    border: 0;
    margin: 16px 0 12px;
  }
  .member-bio { font-size: 13px; color: rgba(214, 229, 241, 0.72); line-height: 1.7; }
  html[lang="en"] .member-bio { line-height: 1.55; }
  .member-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }
  .member-link {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(139, 178, 203, 0.11);
    color: rgba(206, 220, 229, 0.74);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .member-link:hover {
    border-color: rgba(181, 209, 224, 0.22);
    color: rgba(228, 236, 241, 0.88);
    background: rgba(158, 181, 196, 0.06);
  }
</style>
