---
interface Level { label: string; desc: string; }
interface BiDir { label: string; desc: string; }
interface Foundation {
  icon: string;
  title: string;
  en: string;
  intro?: string;
  levels?: Level[];
  bidirectional?: BiDir[];
  footer?: string;
  tags?: string[];
}

const foundations: Foundation[] = [
  {
    icon: '🔬',
    title: '生成式大模型可解释性研究',
    en: 'Quantifiable & Interpretable Generative Models',
    intro: '从微观、中观、宏观三个尺度系统分析主流生成式大模型的内部机理：',
    levels: [
      { label: '微观', desc: '神经元激活表征、局部特征提取与语义编码机制' },
      { label: '中观', desc: '子网络、注意力模块与信息流协同方式' },
      { label: '宏观', desc: '模型泛化边界、涌现能力与表示效率' },
    ],
    footer: '通过揭示模型内在机制，指导架构优化与轻量化部署，推动"以小博大"的高效计算范式。',
  },
  {
    icon: '🧬',
    title: '计算神经科学与交叉创新',
    en: 'AI for Science / Computational Neuroscience',
    bidirectional: [
      { label: '向内借鉴', desc: '从脑科学获取启发，围绕大脑功能区与脑网络构建可计算数学模型，寻求下一代 AI 架构突破。' },
      { label: '向外赋能', desc: '以生成式 AI 支持神经科学研究，分析脑数据、建模神经机制、发现潜在规律。' },
    ],
    tags: ['类脑智能', 'AI for Neuroscience', '跨学科'],
  },
];
---

<section id="foundations" class="py-24" style="background:var(--bg-secondary)">
  <div class="max-w-6xl mx-auto px-6">
    <span class="inline-block text-xs tracking-widest uppercase rounded-full px-3.5 py-1 mb-4" style="color:var(--accent-cyan);border:1px solid var(--border-subtle)">Foundational Research</span>
    <h2 class="text-3xl md:text-4xl font-semibold mb-3 text-white">底层基础研究</h2>
    <p class="text-slate-400 max-w-2xl mb-12">我们拒绝将生成式模型仅仅视为"黑盒"，从模型机理、计算效率与脑科学启发三个层面，为下一代创意人工智能奠定理论基础。</p>
    <div class="grid md:grid-cols-2 gap-5">
      {foundations.map(f => (
        <div class="rounded-xl p-8 transition-transform duration-300 hover:-translate-y-1" style="background:var(--bg-card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,180,216,0.2);box-shadow:0 0 20px rgba(0,180,216,0.08)">
          <div class="text-4xl mb-3">{f.icon}</div>
          <h3 class="text-xl font-semibold mb-1 text-white">{f.title}</h3>
          <p class="text-xs italic text-slate-500 mb-4">{f.en}</p>
          {f.intro && <p class="text-sm text-slate-400 mb-3">{f.intro}</p>}
          {f.levels && (
            <ul class="space-y-2 mb-4 list-none">
              {f.levels.map(l => (
                <li class="flex items-baseline gap-2 text-sm text-slate-400">
                  <span class="text-xs rounded-full px-2 py-0.5 shrink-0" style="color:var(--accent-cyan);background:rgba(0,180,216,0.08);border:1px solid rgba(0,180,216,0.25)">{l.label}</span>
                  {l.desc}
                </li>
              ))}
            </ul>
          )}
          {f.bidirectional && (
            <div class="space-y-2 mb-4">
              {f.bidirectional.map(b => (
                <div class="border-l-2 pl-4" style="border-color:var(--border-subtle)">
                  <div class="text-xs tracking-widest uppercase font-semibold mb-1" style="color:var(--accent-cyan)">{b.label}</div>
                  <p class="text-sm text-slate-400">{b.desc}</p>
                </div>
              ))}
            </div>
          )}
          {f.footer && <p class="text-sm text-slate-400 mt-3">{f.footer}</p>}
          {f.tags && (
            <div class="flex flex-wrap gap-1.5 mt-4">
              {f.tags.map(t => (
                <span class="text-xs rounded-full px-2.5 py-0.5" style="color:var(--accent-cyan);background:rgba(0,180,216,0.08);border:1px solid rgba(0,180,216,0.25)">{t}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
