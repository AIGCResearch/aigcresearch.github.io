---
type QuickCard = {
  id: string;
  icon: string;
  titleZh: string;
  titleEn: string;
  noteZh: string;
  noteEn: string;
  bodyZh: string;
  bodyEn: string;
  secondZh?: string;
  secondEn?: string;
  pointsZh?: string[];
  pointsEn?: string[];
  ctaZh: string;
  ctaEn: string;
};

const quickCards: QuickCard[] = [
  {
    id: "philosophy",
    icon: "mission",
    titleZh: "研究理念",
    titleEn: "Research Philosophy",
    noteZh: "回答为什么要做的问题。",
    noteEn: "Why we do it.",
    bodyZh: "探索机器创造力的边界，拓展人类创造力的边界，塑造一个全新的创意世界。",
    bodyEn: "Explore the boundaries of machine creativity, expand the boundaries of human creativity, and shape a new world of creativity.",
    secondZh: "探索下一代创意智能体与生产力工具，构建开放可持续的创作生态。",
    secondEn: "Explore next-generation creative agents and productivity tools to build an open, sustainable creative ecosystem.",
    ctaZh: "探索未来",
    ctaEn: "Explore Future",
  },
  {
    id: "directions",
    icon: "future",
    titleZh: "研究方向",
    titleEn: "Research Directions",
    noteZh: "回答做什么、怎么做的问题。",
    noteEn: "What we do and how.",
    bodyZh: "面向基础研究的通用创意智能实验室，聚焦应用研究的智能影像叙事实验室，专注创作实践的星联无限灵感工作室。",
    bodyEn: "The Creative General Intelligent Lab pursues foundational research, the Intelligent Cinema Narrative Lab focuses on applied research, and the StarX Infinite Inspiration Studio specializes in creative practice.",
    pointsZh: [
      "面向基础研究的通用创意智能实验室。",
      "聚焦应用研究的智能影像叙事实验室。",
      "专注创作实践的星联无限灵感工作室。",
    ],
    pointsEn: [
      "The Creative General Intelligent Lab pursues foundational research.",
      "The Intelligent Cinema Narrative Lab focuses on applied research.",
      "The StarX Infinite Inspiration Studio specializes in creative practice.",
    ],
    ctaZh: "了解更多",
    ctaEn: "Learn More",
  },
  {
    id: "publications",
    icon: "publication",
    titleZh: "研究成果",
    titleEn: "Research Publications",
    noteZh: "回答做出了什么的问题。",
    noteEn: "What we have achieved.",
    bodyZh: "围绕AIGC、电影制作与世界模型等方向，从问题定义、方法设计、数据构建、模型训练到系统落地。",
    bodyEn: "Across AIGC, filmmaking, and world models, our work spans problem definition, method design, data construction, model training, and deployment.",
    ctaZh: "浏览成果",
    ctaEn: "View Publications",
  },
  {
    id: "team",
    icon: "team",
    titleZh: "研究团队",
    titleEn: "Research Team",
    noteZh: "回答哪些人在做的问题。",
    noteEn: "Who is doing the work.",
    bodyZh: "跨学科、小而精的研究与创作团队，探索未来创意智能的可能性。",
    bodyEn: "A exquisite and interdisciplinary team exploring the future of creative intelligence together.",
    ctaZh: "认识团队",
    ctaEn: "Meet the Team",
  },
];

const capabilityItems = [
  { icon: "vision", zh: "视觉与图形学", en: "CV & CG" },
  { icon: "film", zh: "影视制作", en: "TV & Filmmaking" },
  { icon: "screen", zh: "世界模型", en: "World Model" },
  { icon: "share", zh: "创意智能", en: "Creative Intelligence" },
  { icon: "palette", zh: "智能艺术", en: "Intelligent Art" },
];

const iconPaths: Record<string, string[]> = {
  mission: [
    "M4 20h16",
    "M6 20V9l6-5 6 5v11",
    "M10 20v-4h4v4",
  ],
  team: [
    "M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
    "M16 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
    "M3 20a5 5 0 0 1 10 0",
    "M13 20a4 4 0 0 1 8 0",
  ],
  publication: [
    "M810.666667 128a42.666667 42.666667 0 0 1 42.666666 42.666667v42.666666h85.290667a42.666667 42.666667 0 0 1 42.368 37.674667l0.298667 4.992v128a128 128 0 0 1-120.490667 127.786667l-7.509333 0.213333h-24.832A341.418667 341.418667 0 0 1 554.666667 722.730667V810.666667h170.666666a42.666667 42.666667 0 0 1 0 85.333333H298.666667a42.666667 42.666667 0 0 1 0-85.333333h170.666666v-87.978667a341.418667 341.418667 0 0 1-273.792-210.645333L170.666667 512a128 128 0 0 1-127.786667-120.490667L42.666667 384V256a42.666667 42.666667 0 0 1 37.674666-42.368L85.333333 213.333333h85.333334V170.666667a42.666667 42.666667 0 0 1 42.666666-42.666667h597.333334z m-42.666667 85.333333H256v170.666667a256 256 0 1 0 512 0V257.408L767.957333 256 768 254.592V213.333333zM170.666667 384V298.666667H128v85.333333a42.666667 42.666667 0 0 0 37.674667 42.368L170.666667 426.666667h2.645333A343.552 343.552 0 0 1 170.666667 384z m725.248-85.333333H853.333333v85.333333c0 14.421333-0.896 28.672-2.645333 42.666667h2.56a42.666667 42.666667 0 0 0 42.410667-37.674667L895.957333 384l-0.042666-85.333333z",
  ],
  future: [
    "M4 13a8 8 0 0 1 16 0",
    "M12 3v5",
    "M8 21l4-4 4 4",
    "M12 17V9",
  ],
  palette: [
    "M12 3a9 9 0 1 0 0 18h1.2a2.8 2.8 0 0 0 0-5.6h-.7a1.9 1.9 0 0 1 0-3.8h4A4.5 4.5 0 0 0 21 7.1 8.1 8.1 0 0 0 12 3Z",
    "M7.5 10h.01",
    "M10 7.5h.01",
    "M14 7.5h.01",
  ],
  vision: [
    "M4 5h5",
    "M15 5h5",
    "M4 19h5",
    "M15 19h5",
    "M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5Z",
    "M12 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z",
  ],
  film: [
    "M3 5h18v14H3z",
    "M7 5v14",
    "M17 5v14",
    "M7 9h10",
    "M7 15h10",
  ],
  screen: [
    "M3 4h18v12H3z",
    "M8 20h8",
    "M12 16v4",
  ],
  share: [
    "M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
    "M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
    "M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
    "m8.6 10.8 6.8-4.1",
    "m8.6 13.2 6.8 4.1",
  ],
};

const iconViewBoxes: Record<string, string> = {
  publication: "0 0 1024 1024",
};

const filledIcons = new Set(["publication"]);
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-inner container">
    <div class="hero-side hero-side--left reveal">
      <p class="hero-side-title"><span data-lang="zh">通用创意智能 CGI</span><span data-lang="en">Creative General Intelligence (CGI)</span></p>
      <p class="hero-side-detail"><span data-lang="zh">探索机器创造力的边界</span><span data-lang="en">Expand the Boundaries of Machine Creativity</span></p>
    </div>

    <div class="hero-side hero-side--right reveal">
      <p class="hero-side-title"><span data-lang="zh">智能创意工作流 ICW</span><span data-lang="en">Intelligent Creative Workflow (ICW)</span></p>
      <p class="hero-side-detail"><span data-lang="zh">拓展人类创造力的边界</span><span data-lang="en">Expand the Boundaries of Human Creativity</span></p>
    </div>

    <div class="hero-center">
      <div class="hero-logo-wrap reveal" role="img" aria-label="AIGC Research">
        <div class="hero-rings" aria-hidden="true"></div>
        <img class="hero-logo hero-logo--light" src="/images/logo-hero-light.webp" alt="" width="720" height="715" fetchpriority="high" decoding="sync" />
        <img class="hero-logo hero-logo--dark" src="/images/logo-hero-dark.webp" alt="" width="720" height="715" fetchpriority="high" decoding="sync" />
      </div>

      <div class="hero-copy reveal">
        <h1 class="hero-title" id="hero-title">
          <span data-lang="zh">创意人工智能研究院</span>
          <span data-lang="en">AIGC Research</span>
        </h1>
        <p class="hero-subtitle">
          <span data-lang="zh">AI for Creativity (AI4C) Research</span>
          <span data-lang="en">AI for Creativity (AI4C) Research</span>
        </p>

        <ul class="hero-values">
          <li><span data-lang="zh">创新</span><span data-lang="en">Innovation</span></li>
          <li><span data-lang="zh">创意</span><span data-lang="en">Creativity</span></li>
          <li><span data-lang="zh">科学</span><span data-lang="en">Science</span></li>
          <li><span data-lang="zh">艺术</span><span data-lang="en">Art</span></li>
        </ul>
      </div>
    </div>

    <div class="hero-cards reveal">
      {quickCards.map((card) => (
        <a class="hero-card" href={`#${card.id}`}>
          <span class="card-hover-ring" aria-hidden="true"></span>
          <div class="hero-card-head">
            <h2 class="hero-card-title">
              <span data-lang="zh">{card.titleZh}</span>
              <span data-lang="en">{card.titleEn}</span>
            </h2>
            <span class="hero-card-icon" aria-hidden="true">
              <svg
                viewBox={iconViewBoxes[card.icon] ?? "0 0 24 24"}
                width="28"
                height="28"
                fill={filledIcons.has(card.icon) ? "currentColor" : "none"}
                stroke={filledIcons.has(card.icon) ? "none" : "currentColor"}
                stroke-width={filledIcons.has(card.icon) ? undefined : "1.7"}
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {iconPaths[card.icon].map((path) => <path d={path}></path>)}
              </svg>
            </span>
          </div>
          <p class="hero-card-note">
            <span data-lang="zh">{card.noteZh}</span>
            <span data-lang="en">{card.noteEn}</span>
          </p>
          {card.pointsZh ? (
            <div class="hero-card-body">
              <ol class="hero-card-points" data-lang="zh">
                {card.pointsZh.map((point) => <li>{point}</li>)}
              </ol>
              <ol class="hero-card-points" data-lang="en">
                {card.pointsEn?.map((point) => <li>{point}</li>)}
              </ol>
            </div>
          ) : card.secondZh ? (
            <div class="hero-card-body">
              <ol class="hero-card-points" data-lang="zh">
                <li>{card.bodyZh}</li>
                <li>{card.secondZh}</li>
              </ol>
              <ol class="hero-card-points" data-lang="en">
                <li>{card.bodyEn}</li>
                <li>{card.secondEn}</li>
              </ol>
            </div>
          ) : (
            <p class="hero-card-body">
              <span data-lang="zh">{card.bodyZh}</span>
              <span data-lang="en">{card.bodyEn}</span>
            </p>
          )}
          <span class="hero-card-link">
            <span data-lang="zh">{card.ctaZh}</span>
            <span data-lang="en">{card.ctaEn}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="hero-capabilities reveal">
      <p class="hero-capabilities-heading"><span data-lang="zh">研究领域</span><span data-lang="en">Research Areas</span></p>
      <ul class="hero-capabilities-list">
        {capabilityItems.map((item) => (
          <li class="hero-capability">
            <span class="hero-capability-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {iconPaths[item.icon].map((path) => <path d={path}></path>)}
              </svg>
            </span>
            <span class="hero-capability-title">
              <span data-lang="zh">{item.zh}</span>
              <span data-lang="en">{item.en}</span>
            </span>
          </li>
        ))}
      </ul>
      <blockquote class="hero-quote">
        <p>
          <span data-lang="zh">技术是画笔，想象是色彩，合作是画布。我们共同绘制未来的创意图景。</span>
          <span data-lang="en">Technology is the brush, imagination the color, and collaboration the canvas. Together, we paint the future of creativity.</span>
        </p>
      </blockquote>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 96svh;
    overflow: hidden;
    padding: 158px 0 22px;
  }

  .hero-rings {
    position: absolute;
    top: calc(50% - 4px);
    left: 50%;
    width: clamp(360px, 38vw, 520px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    filter: blur(22px);
    opacity: var(--hero-halo-dark-opacity, 0.7);
    transition: opacity 120ms linear;
    animation: hero-halo-pulse 2.8s ease-in-out infinite alternate;
  }

  .hero-rings::before,
  .hero-rings::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    mask-image: radial-gradient(circle, transparent 20%, #000 37%, rgba(0, 0, 0, 0.75) 49%, transparent 72%);
    -webkit-mask-image: radial-gradient(circle, transparent 20%, #000 37%, rgba(0, 0, 0, 0.75) 49%, transparent 72%);
  }

  .hero-rings::before {
    background: conic-gradient(from -45deg,
      rgba(47, 213, 198, 0.68) 0deg,
      rgba(225, 234, 47, 0.68) 90deg,
      rgba(38, 211, 188, 0.64) 180deg,
      rgba(2, 164, 218, 0.68) 270deg,
      rgba(47, 213, 198, 0.68) 360deg);
    animation: hero-halo-appear 1.5s var(--ease-out) both;
  }

  .hero-rings::after {
    background: conic-gradient(from -45deg,
      transparent 0deg 272deg,
      rgba(42, 208, 196, 0.06) 291deg,
      rgba(225, 234, 47, 0.48) 326deg,
      transparent 360deg);
    animation: hero-halo-orbit 10s linear infinite, hero-halo-glint-appear 1.6s ease-out both;
  }

  @keyframes hero-halo-appear {
    from { opacity: 0; transform: scale(0.86); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes hero-halo-pulse {
    from { transform: translate(-50%, -50%) scale(0.52); }
    to { transform: translate(-50%, -50%) scale(1.08); }
  }

  @keyframes hero-halo-orbit {
    to { transform: rotate(360deg); }
  }

  @keyframes hero-halo-glint-appear {
    from { opacity: 0; }
    to { opacity: 0.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rings,
    .hero-rings::before,
    .hero-rings::after { animation: none; }
    .hero-rings::after { opacity: 0; }
  }

  .hero-inner {
    position: relative;
  }

  .hero-side {
    position: absolute;
    top: 88px;
    max-width: 240px;
    color: rgba(233, 243, 255, 0.9);
    text-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-side--left { left: 4.5%; }
  .hero-side--right { right: 4.5%; text-align: right; }

  .hero-side-title,
  .hero-side-detail {
    margin: 0;
  }

  .hero-side-title {
    font-size: var(--type-medium);
    line-height: 1.22;
    font-weight: 500;
    margin-top: 6px;
  }

  .hero-side-detail {
    font-size: var(--type-small);
    line-height: 1.55;
    color: rgba(210, 230, 245, 0.68);
    margin-top: 10px;
  }

  .hero-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 8px;
  }

  .hero-logo-wrap {
    position: relative;
    width: clamp(164px, 18vw, 220px);
    margin-bottom: 20px;
    aspect-ratio: 2163 / 2149;
  }
  .hero-logo {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 180ms ease;
  }
  .hero-logo--light { opacity: 0; }
  .hero-logo--dark { opacity: var(--hero-logo-opacity, 1); }
  :global(html[data-theme="light"]) .hero-logo--light { opacity: var(--hero-logo-opacity, 1); }
  :global(html[data-theme="light"]) .hero-logo--dark { opacity: 0; }

  .hero-copy { max-width: 820px; }

  .hero-title {
    font-size: var(--type-large);
    line-height: 1.16;
    letter-spacing: 0.02em;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.38);
  }

  .hero-subtitle {
    margin-top: 4px;
    font-size: var(--type-medium);
    line-height: 1.35;
    color: rgba(225, 240, 250, 0.9);
    text-shadow: 0 6px 26px rgba(0, 0, 0, 0.32);
  }

  .hero-values {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    width: max-content;
    max-width: 100%;
    margin: 26px auto 0;
    padding: 14px 0 0;
    border-top: 1px solid rgba(184, 211, 227, 0.22);
    list-style: none;
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(229, 236, 245, 0.88);
  }

  .hero-values li {
    display: flex;
    align-items: center;
    line-height: 1.4;
    white-space: nowrap;
  }

  .hero-values li + li::before {
    content: "";
    flex: 0 0 3px;
    width: 3px;
    height: 3px;
    margin: 0 18px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2fd5c6, #e1ea2f);
  }

  .hero-cards {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .hero-card {
    min-height: 228px;
    padding: 18px 18px 18px;
    border-radius: 18px;
    border: 1px solid rgba(143, 206, 255, 0.12);
    background:
      linear-gradient(180deg, rgba(19, 49, 79, 0.72), rgba(7, 27, 48, 0.82)),
      rgba(10, 28, 48, 0.7);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(197, 235, 255, 0.05),
      0 18px 44px rgba(3, 13, 24, 0.3);
    display: flex;
    flex-direction: column;
    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }

  .hero-card:hover {
    transform: translateY(-5px);
    border-color: rgba(110, 224, 255, 0.34);
    box-shadow:
      inset 0 1px 0 rgba(197, 235, 255, 0.08),
      0 24px 56px rgba(3, 13, 24, 0.36);
  }

  .hero-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .hero-card-title {
    font-size: var(--type-medium);
    line-height: 1.3;
    font-weight: 600;
  }

  .hero-card-body {
    margin-top: 12px;
    color: rgba(217, 230, 243, 0.82);
    font-size: var(--type-small);
    line-height: 1.8;
    flex: 1;
  }

  .hero-card-points {
    margin: 0;
    padding-left: 1.35em;
  }

  .hero-card-points li + li { margin-top: 8px; }
  .hero-card-points li::marker { color: rgba(146, 211, 229, 0.86); }

  .hero-card-note {
    margin-top: 7px;
    color: rgba(146, 211, 229, 0.86);
    font-size: var(--type-small);
    line-height: 1.5;
  }

  .hero-card-link {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #73dfff;
    font-size: var(--type-small);
  }

  .hero-card-link::after {
    content: "";
    width: 88px;
    height: 1px;
    background: linear-gradient(90deg, rgba(115, 223, 255, 0.65), rgba(115, 223, 255, 0));
  }

  .hero-card-icon,
  .hero-capability-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(108, 224, 255, 0.95);
  }

  .hero-card-icon {
    width: 28px;
    height: 28px;
    opacity: 0.9;
  }

  .hero-card-icon svg,
  .hero-capability-icon svg {
    width: 100%;
    height: 100%;
  }

  .hero-capabilities {
    margin: 44px auto 0;
    width: 100%;
    max-width: 1140px;
    padding: 18px 26px 22px;
    border-radius: 18px;
    border: 1px solid rgba(116, 201, 255, 0.17);
    box-shadow: inset 0 1px 0 rgba(200, 236, 255, 0.05), 0 14px 38px rgba(3, 13, 24, 0.16);
  }

  .hero-capabilities-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    text-align: center;
    color: var(--accent-cyan);
    font-size: var(--type-small);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .hero-capabilities-heading::before,
  .hero-capabilities-heading::after {
    content: "";
    height: 1px;
    flex: 1;
  }

  .hero-capabilities-heading::before {
    background: linear-gradient(90deg, transparent, rgba(116, 201, 255, 0.28));
  }

  .hero-capabilities-heading::after {
    background: linear-gradient(90deg, rgba(116, 201, 255, 0.28), transparent);
  }

  .hero-capabilities-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 0;
    margin: 16px 0 0;
    list-style: none;
  }

  .hero-capability {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-width: 0;
    padding: 6px 12px;
  }

  .hero-capability + .hero-capability {
    border-left: 1px solid rgba(133, 185, 214, 0.18);
  }

  .hero-capability-icon {
