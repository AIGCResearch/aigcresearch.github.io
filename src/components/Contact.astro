---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">05</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="contact-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.body}</span><span data-lang="en">{e.body}</span>
        </p>
      </div>
    </header>

    <div class="contact-grid">
      <div class="contact-block contact-email reveal">
        <p class="contact-block-label">Email</p>
        <a class="btn btn-primary" href={`mailto:${z.email}`}>
          <span data-lang="zh">{z.emailCtaLabel}</span><span data-lang="en">{e.emailCtaLabel}</span>
          <span class="contact-email-addr">{z.email}</span>
        </a>
      </div>

      <div class="contact-block contact-wechat reveal">
        <p class="contact-block-label">
          <span data-lang="zh">{z.wechatTitle}</span><span data-lang="en">{e.wechatTitle}</span>
        </p>
        <div class="qr-frame">
          <img class="qr-image" src="/images/qr-code.png" alt={z.wechatTitle} />
        </div>
        <p class="contact-wechat-note">
          <span data-lang="zh">{z.wechatNote}</span><span data-lang="en">{e.wechatNote}</span>
        </p>
      </div>

      <div class="contact-block contact-socials reveal">
        <p class="contact-block-label">Channels</p>
        <ul class="socials">
          {z.socials.map((s) => {
            const disabled = s.disabled;
            const path = iconPath[s.icon] ?? "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z";
            return (
              <li>
                <a
                  class={`social social--${s.icon}${disabled ? " is-disabled" : ""}`}
                  href={disabled ? undefined : s.href}
                  aria-label={s.label}
                  aria-disabled={disabled ? "true" : undefined}
                  title={disabled ? "Link coming soon" : s.label}
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d={path} fill="currentColor" fill-rule={s.icon === "youtube" ? "evenodd" : undefined}></path>
                  </svg>
                  <span class="social-label">{s.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(90, 143, 178, 0.05), transparent 36%),
      linear-gradient(180deg, rgba(8, 23, 37, 0.78), rgba(5, 17, 29, 0.9));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: var(--type-small);
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.2fr;
    gap: 18px;
  }
  .contact-block {
    padding: 24px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(138, 175, 198, 0.045), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 44, 0.86), rgba(7, 21, 33, 0.94));
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(12px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .contact-block-label {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .contact-email .btn-primary {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 18px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(170, 196, 214, 0.12), rgba(101, 124, 141, 0.12));
    border: 1px solid rgba(164, 192, 209, 0.14);
  }
  .contact-email-addr { font-family: var(--font-mono); font-size: var(--type-small); opacity: 0.7; }

  .qr-frame {
    width: 160px;
    height: 160px;
    padding: 10px;
    border: 1px solid rgba(154, 187, 208, 0.18);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .qr-image { width: 100%; height: 100%; object-fit: contain; display: block; }
  .contact-wechat-note { font-size: var(--type-small); color: var(--text-muted); }

  .socials { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid rgba(139, 178, 203, 0.09);
    color: rgba(214, 229, 241, 0.68);
    font-size: var(--type-small);
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  .social:hover { border-color: rgba(181, 209, 224, 0.22); color: rgba(228, 236, 241, 0.88); background: rgba(158, 181, 196, 0.06); }
  .social.is-disabled { opacity: 0.5; cursor: not-allowed; }
  .social.is-disabled:hover { opacity: 0.8; }
  .social-label { font-family: var(--font-mono); letter-spacing: 0.08em; }

  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; }
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
