---
interface Member {
  name: string;
  role: string;
  field: string;
  initial: string;
  advisor: boolean;
}

const members: Member[] = [
  { name: '庄才林', role: '上海科技大学 · 硕士研究生', field: 'AIGC · 生成式模型', initial: '庄', advisor: false },
  { name: '胡耀淇', role: '研究成员', field: '创意人工智能', initial: '胡', advisor: false },
  { name: '董政', role: '研究成员', field: '创意人工智能', initial: '董', advisor: false },
];

const advisors: Member[] = [
  { name: '程巍', role: '阶跃星辰 · 研究科学家', field: '生成式人工智能 · 工业界导师', initial: '程', advisor: true },
  { name: '夏清零', role: '重庆理工大学 · 导师', field: '生物医学工程 · 学术界导师', initial: '夏', advisor: true },
];
---

<section id="team" class="py-24" style="background:var(--bg-primary)">
  <div class="max-w-6xl mx-auto px-6">
    <span class="inline-block text-xs tracking-widest uppercase rounded-full px-3.5 py-1 mb-4" style="color:var(--accent-cyan);border:1px solid var(--border-subtle)">Team</span>
    <h2 class="text-3xl md:text-4xl font-semibold mb-3 text-white">团队成员</h2>
    <p class="text-slate-400 max-w-2xl mb-10">AIGC Research 由一支关注创意人工智能、生成式模型与跨学科基础研究的小型团队组成，与工业界、学术界导师保持持续合作。</p>

    <h3 class="text-xs tracking-widest uppercase text-slate-500 mb-4">核心成员</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      {members.map(m => (
        <div class="flex items-center gap-4 p-5 rounded-xl transition-transform duration-300 hover:-translate-y-0.5" style="background:var(--bg-card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,180,216,0.2)">
          <div class="w-12 h-12 rounded-full flex items-center justify-center text-lg font-bold text-white shrink-0" style="background:linear-gradient(135deg,var(--accent-blue),var(--accent-cyan))">
            {m.initial}
          </div>
          <div>
            <div class="font-semibold text-white">{m.name}</div>
            <div class="text-xs text-slate-500 mt-0.5">{m.role}</div>
            <div class="text-xs mt-0.5" style="color:var(--accent-cyan)">{m.field}</div>
          </div>
        </div>
      ))}
    </div>

    <h3 class="text-xs tracking-widest uppercase text-slate-500 mb-4">合作导师</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
      {advisors.map(a => (
        <div class="flex items-center gap-4 p-5 rounded-xl transition-transform duration-300 hover:-translate-y-0.5" style="background:var(--bg-card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,180,216,0.2)">
          <div class="w-12 h-12 rounded-full flex items-center justify-center text-lg font-bold text-white shrink-0" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa)">
            {a.initial}
          </div>
          <div>
            <div class="font-semibold text-white">{a.name}</div>
            <div class="text-xs text-slate-500 mt-0.5">{a.role}</div>
            <div class="text-xs mt-0.5" style="color:var(--accent-cyan)">{a.field}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
