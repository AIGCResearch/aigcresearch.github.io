---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";
import MemberCard from "./MemberCard.astro";
const z = zh.team;
const e = en.team;
const partners = [
  { key: "fudan", zh: "复旦大学", en: "Fudan University", image: "/images/fudan-university-logo.webp", imageDark: "/images/fudan-university-logo-dark-blue.webp", url: "https://www.fudan.edu.cn/" },
  { key: "fudan-computing", zh: "复旦大学计算与智能创新学院", en: "Fudan University · College of Computer Science and Artificial Intelligence", image: "/images/partners/fudan-computing.webp", url: "https://cs.fudan.edu.cn/" },
  { key: "fudan-ai3", zh: "复旦大学人工智能创新与产业研究院", en: "Fudan University · Institute of AI Innovation and Industry", image: "/images/partners/fudan-ai3-mark-muted.webp", url: "https://ai3.fudan.edu.cn/" },
  { key: "sais", zh: "上海科学智能研究院", en: "Shanghai Academy of AI for Science", image: "/images/partners/shanghai-ai-for-science.png", url: "https://sais.com.cn/" },
  { key: "shanghaitech", zh: "上海科技大学", en: "ShanghaiTech University", image: "/images/partners/shanghaitech-university.webp", url: "https://www.shanghaitech.edu.cn/" },
  { key: "shu", zh: "上海大学", en: "Shanghai University", image: "/images/partners/shanghai-university.webp", url: "https://www.shu.edu.cn/" },
  { key: "sfa", zh: "上海电影学院", en: "Shanghai Film Academy", image: "/images/partners/shanghai-film-academy.webp", url: "https://sfa.shu.edu.cn/" },
  { key: "cqut", zh: "两江人工智能学院", en: "CQUT·School of Artificial Intelligence", image: "/images/partners/cqut-liangjiang-ai.webp", url: "https://ai.cqut.edu.cn/" },
  { key: "stepfun", zh: "阶跃星辰", en: "StepFun", image: "/images/partners/stepfun.webp", url: "https://www.stepfun.com/" },
  { key: "teleai", zh: "中国电信 TeleAI", en: "China Telecom · TeleAI", image: "/images/partners/teleai.webp", url: "https://www.teleai.com.cn/" },
];
---
<section class="section team" id="team" aria-labelledby="team-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">04</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="team-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <h3 class="group-divider group-divider--first reveal">
      <span class="group-line" aria-hidden="true"></span>
      <span class="group-label">
        <span data-lang="zh">{z.membersLabel}</span><span data-lang="en">{e.membersLabel}</span>
      </span>
      <span class="group-line" aria-hidden="true"></span>
    </h3>

    <div class="member-grid">
      {z.members.map((m, i) => (
        <MemberCard memberZh={m} memberEn={e.members[i]} collapsibleBio />
      ))}
    </div>

    <h3 class="group-divider reveal">
      <span class="group-line" aria-hidden="true"></span>
      <span class="group-label">
        <span data-lang="zh">{z.advisorsLabel}</span><span data-lang="en">{e.advisorsLabel}</span>
      </span>
      <span class="group-line" aria-hidden="true"></span>
    </h3>

    <div class="member-grid">
      {z.advisors.map((m, i) => (
        <MemberCard memberZh={m} memberEn={e.advisors[i]} />
      ))}
    </div>

    <h3 class="group-divider reveal">
      <span class="group-line" aria-hidden="true"></span>
      <span class="group-label"><span data-lang="zh">合作机构</span><span data-lang="en">Partners</span></span>
      <span class="group-line" aria-hidden="true"></span>
    </h3>

    <div class="partners-rows reveal">
      {[partners.slice(0, 4), partners.slice(4)].map((row, index) => (
        <div class={`partners-grid partners-grid--${index === 0 ? "first" : "second"}`}>
          {row.map((partner) => (
            <a class="partner-card" href={partner.url} target="_blank" rel="noopener noreferrer">
              <span class="card-hover-ring" aria-hidden="true"></span>
              <span class="partner-logo-wrap">
                <img class={`partner-logo partner-logo--${partner.key} ${"imageDark" in partner ? "partner-logo--light" : ""}`} src={partner.image} alt="" loading="lazy" decoding="async" />
                {"imageDark" in partner && <img class={`partner-logo partner-logo--${partner.key} partner-logo--dark`} src={partner.imageDark} alt="" loading="lazy" decoding="async" />}
              </span>
              <span class="partner-name"><span data-lang="zh">{partner.zh}</span><span data-lang="en">{partner.en}</span></span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(88, 137, 168, 0.05), transparent 36%),
      linear-gradient(180deg, rgba(8, 23, 37, 0.76), rgba(5, 17, 29, 0.88));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: var(--type-small);
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .group-divider {
    margin: 50px auto 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 520px;
    font-weight: 400;
  }
  .group-divider--first { margin-top: 0; }
  .group-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--surface-border-strong), transparent);
  }
  .group-label {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    white-space: nowrap;
  }

  .partners-rows { display: grid; gap: 12px; }
  .partners-grid {
    display: grid;
    gap: 12px;
  }
  .partners-grid--first { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .partners-grid--second { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .partner-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 146px;
    gap: 12px;
    padding: 17px 9px 15px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(139, 178, 203, 0.16);
    border-radius: 16px;
    background: rgba(11, 34, 66, 0.46);
    backdrop-filter: blur(16px) saturate(135%);
    -webkit-backdrop-filter: blur(16px) saturate(135%);
    color: var(--text-primary);
    text-align: center;
    transition: transform 240ms var(--ease-out), border-color 240ms var(--ease-out);
  }
  .partner-card:hover { transform: translateY(-4px); color: var(--text-primary); }
  .partner-logo-wrap {
    display: grid;
    place-items: center;
    width: 100%;
    height: 64px;
  }
  .partner-logo {
    grid-area: 1 / 1;
    width: auto;
    max-width: min(100%, 160px);
    max-height: 60px;
    object-fit: contain;
  }
  .partner-logo--fudan,
  .partner-logo--shanghaitech,
  .partner-logo--teleai { width: 60px; height: 60px; }
  .partner-logo--cqut { width: 60px; height: 60px; }
  .partner-logo--stepfun { max-width: 136px; }
  .partners-grid--first .partner-logo { max-width: min(100%, 230px); }
  .partner-name {
    font-size: var(--type-small);
    line-height: 1.45;
    font-weight: 600;
  }
  :global(html[data-theme="dark"]) .partner-logo--sfa {
    filter: brightness(0) saturate(100%) invert(88%) sepia(7%) saturate(1139%) hue-rotate(173deg);
  }
  :global(html[data-theme="dark"]) .partner-logo--shanghaitech { filter: brightness(1.52) saturate(0.58); }
  :global(html[data-theme="dark"]) .partner-logo--teleai {
    border-radius: 50%;
    background: #fff;
  }
  .partner-logo--dark { display: none; }
  :global(html[data-theme="dark"]) .partner-logo--light { display: none; }
  :global(html[data-theme="dark"]) .partner-logo--dark { display: block; }
  :global(html[data-theme="dark"]) .partner-logo--fudan.partner-logo--dark { filter: brightness(1.2); }
  :global(html[data-theme="dark"]) .partner-logo--sais { filter: brightness(1.8) saturate(0.55); }
  :global(html[data-theme="dark"]) .partner-logo--fudan-ai3 { filter: brightness(1.2) saturate(1.8); }
  :global(html[data-theme="light"]) .partner-logo--fudan-ai3 {
    filter: brightness(0) saturate(100%) invert(26%) sepia(29%) saturate(1267%) hue-rotate(165deg);
  }
  :global(html[data-theme="dark"]) .partner-logo--stepfun { filter: invert(1); }
  :global(html[data-theme="light"]) .partner-logo--shu {
    filter: brightness(0) saturate(100%) invert(26%) sepia(29%) saturate(1267%) hue-rotate(165deg);
  }
  :global(html[data-theme="light"]) .partner-card {
    border-color: rgba(70, 132, 166, 0.2);
    background: rgba(244, 246, 255, 0.52);
    color: #24495e;
  }
  :global(html[data-theme="light"]) .partner-card:hover { color: #173f57; }

  @media (max-width: 1000px) {
    .member-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .partners-grid--first { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .partners-grid--second { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .member-grid { grid-template-columns: 1fr; }
    .partners-grid--first,
    .partners-grid--second { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
