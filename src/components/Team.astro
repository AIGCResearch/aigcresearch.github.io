---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";
import MemberCard from "./MemberCard.astro";
const z = zh.team;
const e = en.team;
---
<section class="section team" id="team" aria-labelledby="team-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">04</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="team-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <div class="member-grid">
      {z.members.map((m, i) => (
        <MemberCard memberZh={m} memberEn={e.members[i]} />
      ))}
    </div>

    <div class="advisors-divider reveal" aria-hidden="true">
      <span class="advisors-line"></span>
      <span class="advisors-label">
        <span data-lang="zh">{z.advisorsLabel}</span><span data-lang="en">{e.advisorsLabel}</span>
      </span>
      <span class="advisors-line"></span>
    </div>

    <div class="member-grid member-grid--advisors">
      {z.advisors.map((m, i) => (
        <MemberCard memberZh={m} memberEn={e.advisors[i]} />
      ))}
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(88, 137, 168, 0.05), transparent 36%),
      linear-gradient(180deg, rgba(8, 23, 37, 0.76), rgba(5, 17, 29, 0.88));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: 16px;
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .advisors-divider {
    margin: 50px auto 22px;
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 520px;
  }
  .advisors-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--surface-border-strong), transparent);
  }
  .advisors-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    white-space: nowrap;
  }

  .member-grid--advisors {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-inline: auto;
    max-width: 760px;
  }
  @media (max-width: 860px) {
    .member-grid, .member-grid--advisors { grid-template-columns: 1fr; }
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
