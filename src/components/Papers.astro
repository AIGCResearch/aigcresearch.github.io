---
interface PaperLink { label: string; href: string; }
interface Paper {
  index: string;
  title: string;
  full: string;
  tags: string[];
  desc: string;
  links: PaperLink[];
}

const papers: Paper[] = [
  {
    index: '01',
    title: 'ViStoryBench',
    full: 'A Comprehensive Benchmark Suite for Story Visualization',
    tags: ['Benchmark', 'Story Visualization'],
    desc: '面向视觉故事讲述的综合性基准测试，重新定义影视叙事生成的评测方式。衡量模型在角色一致性、风格稳定性、剧情对齐与故事可视化方面的真实能力。',
    links: [
      { label: 'Tech Report', href: '#' },
      { label: 'Code', href: '#' },
      { label: 'Dataset', href: '#' },
      { label: 'Project Page', href: '#' },
    ],
  },
  {
    index: '02',
    title: 'StyleMe3D',
    full: 'Stylization with Disentangled Priors by Multiple Encoders on 3D Gaussians',
    tags: ['3D', 'Stylization'],
    desc: '面向 3D 创意表达的风格化研究，探索通过多编码器与解耦先验实现更稳定、更灵活的 3D 高斯场景风格控制。',
    links: [
      { label: 'Tech Report', href: '#' },
      { label: 'Project Page', href: '#' },
      { label: 'Code', href: '#' },
    ],
  },
  {
    index: '03',
    title: 'ShotStudio',
    full: 'Towards Comprehensive Film Creation | From Creativity to Filmmaking',
    tags: ['Film Creation', 'Framework'],
    desc: '面向完整影视创作流程的 AIGC 框架探索，将创意理解、镜头组织、素材生成与创作流程协同串联，是不断演化的创意工作流实验场。',
    links: [
      { label: 'Code', href: '#' },
      { label: 'Demo', href: '#' },
    ],
  },
  {
    index: '04',
    title: 'Act2Cut',
    full: 'Continuous Multi-Shot Video Narrative Match on Action',
    tags: ['Video', 'Multi-Shot', 'Action-Cut'],
    desc: '聚焦多镜头视频叙事中的动作连续性建模，强调镜头切换与电影语法的协同关系，支持 Text / Image / Video 驱动的多镜头生成。',
    links: [
      { label: 'Paper', href: '#' },
      { label: 'Project Page', href: '#' },
    ],
  },
  {
    index: '05',
    title: 'Awesome-PaperDaily',
    full: 'Following the Advance of AIGC',
    tags: ['Open Source', 'Curation'],
    desc: '持续追踪 AIGC 前沿进展的开源知识整理项目，体现团队在知识组织、趋势追踪与社区共享方面的持续投入与开放态度。',
    links: [{ label: 'GitHub', href: '#' }],
  },
];
---

<section id="papers" class="py-24" style="background:var(--bg-primary)">
  <div class="max-w-6xl mx-auto px-6">
    <span class="inline-block text-xs tracking-widest uppercase rounded-full px-3.5 py-1 mb-4" style="color:var(--accent-cyan);border:1px solid var(--border-subtle)">Selected Works</span>
    <h2 class="text-3xl md:text-4xl font-semibold mb-3 text-white">代表成果</h2>
    <p class="text-slate-400 max-w-2xl mb-12">每项成果均明确回答了一个核心问题，优先展示代表团队主线方向的研究。</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {papers.map(p => (
        <div class="flex flex-col rounded-xl p-6 transition-transform duration-300 hover:-translate-y-1" style="background:var(--bg-card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(0,180,216,0.2);box-shadow:0 0 20px rgba(0,180,216,0.08)">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-mono text-slate-500">{p.index}</span>
            {p.tags.map(t => (
              <span class="text-xs rounded-full px-2 py-0.5" style="color:var(--accent-cyan);background:rgba(0,180,216,0.08);border:1px solid rgba(0,180,216,0.25)">{t}</span>
            ))}
          </div>
          <h3 class="text-xl font-semibold mb-1 text-white">{p.title}</h3>
          <p class="text-xs italic text-slate-500 mb-3 leading-relaxed">{p.full}</p>
          <p class="text-sm text-slate-400 leading-relaxed flex-1 mb-4">{p.desc}</p>
          <div class="flex flex-wrap gap-1.5 mt-auto">
            {p.links.map(l => (
              <a href={l.href} class="paper-link text-xs rounded-md px-3 py-1 transition-all duration-300" style="color:#94a3b8;border:1px solid rgba(255,255,255,0.1)">
                {l.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .paper-link:hover {
    color: var(--accent-cyan);
    border-color: var(--border-subtle);
  }
</style>
