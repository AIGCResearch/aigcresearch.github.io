---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";
import PubCard from "./PubCard.astro";

const z = zh.publications;
const e = en.publications;
const hiddenIds = new Set(["shotstudio"]);
const visibleZhItems = z.items.filter((item) => !hiddenIds.has(item.id));
const visibleEnItems = e.items.filter((item) => !hiddenIds.has(item.id));
---
<section class="section publications" id="publications" aria-labelledby="publications-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">03</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="publications-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <div class="pub-grid">
      {visibleZhItems.map((it, i) => (
        <PubCard itemZh={it} itemEn={visibleEnItems[i]} />
      ))}
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(90, 143, 178, 0.05), transparent 36%),
      linear-gradient(180deg, rgba(8, 23, 37, 0.76), rgba(5, 17, 29, 0.88));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: 16px;
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  /* 2-column grid — bigger thumbnails so each project reads as a film card */
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 768px) {
    .pub-grid { grid-template-columns: 1fr; gap: 18px; }
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
