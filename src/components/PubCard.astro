---
import type { Publication } from "../data/types";
interface Props { itemZh: Publication; itemEn: Publication; }
const { itemZh, itemEn } = Astro.props;

const visuals: Record<string, { from: string; to: string; motif: string }> = {
  vistorybench:        { from: "#5C8DFF", to: "#0B1A2E", motif: "storyboard" },
  styleme3d:           { from: "#9B7BFF", to: "#0B1A2E", motif: "gaussian" },
  shotstudio:          { from: "#F2C58A", to: "#0B1A2E", motif: "filmstrip" },
  act2cut:             { from: "#7FD7FF", to: "#0B1A2E", motif: "frames" },
  "awesome-paperdaily":{ from: "#B6F5C9", to: "#0B1A2E", motif: "stack" },
};
const v = visuals[itemZh.id] ?? visuals.vistorybench;
const gaussianDots = Array.from({ length: 28 }).map((_, i) => ({
  cx: 30 + (i * 13 + (i * i * 7)) % 150,
  cy: 20 + (i * 9 + i * 11) % 90,
  r: 4 + (i % 6),
  o: 0.15 + (i % 5) * 0.12,
}));
---
<article class={`pub-card reveal${itemZh.featured ? " pub-card--featured" : ""}`}>
  <div class="pub-thumb" aria-hidden="true">
    <div class="pub-thumb-bg" style={`background: radial-gradient(120% 100% at 20% 0%, ${v.from}33 0%, transparent 60%), linear-gradient(160deg, ${v.from}22 0%, ${v.to} 80%);`}></div>

    {v.motif === "storyboard" && (
      <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
        <rect x="10"  y="14" width="34" height="22" rx="2"/>
        <rect x="50"  y="14" width="34" height="22" rx="2"/>
        <rect x="90"  y="14" width="34" height="22" rx="2"/>
        <rect x="130" y="14" width="34" height="22" rx="2"/>
        <rect x="10"  y="48" width="34" height="22" rx="2"/>
        <rect x="50"  y="48" width="34" height="22" rx="2"/>
        <rect x="90"  y="48" width="34" height="22" rx="2"/>
        <rect x="130" y="48" width="34" height="22" rx="2"/>
        <rect x="10"  y="82" width="34" height="22" rx="2"/>
        <rect x="50"  y="82" width="34" height="22" rx="2" stroke-width="1.4" stroke="#7FD7FF"/>
        <rect x="90"  y="82" width="34" height="22" rx="2"/>
        <rect x="130" y="82" width="34" height="22" rx="2"/>
      </svg>
    )}

    {v.motif === "gaussian" && (
      <svg class="pub-motif" viewBox="0 0 200 120" fill="none" aria-hidden="true">
        {gaussianDots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r={d.r} fill="#9B7BFF" opacity={d.o}/>
        ))}
      </svg>
    )}

    {v.motif === "filmstrip" && (
      <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
        <rect x="10" y="36" width="180" height="48" rx="3"/>
        <rect x="14" y="40" width="16" height="8" rx="1"/>
        <rect x="34" y="40" width="16" height="8" rx="1"/>
        <rect x="54" y="40" width="16" height="8" rx="1"/>
        <rect x="74" y="40" width="16" height="8" rx="1"/>
        <rect x="94" y="40" width="16" height="8" rx="1"/>
        <rect x="114" y="40" width="16" height="8" rx="1"/>
        <rect x="134" y="40" width="16" height="8" rx="1"/>
        <rect x="154" y="40" width="16" height="8" rx="1"/>
        <rect x="174" y="40" width="16" height="8" rx="1"/>
        <rect x="14" y="72" width="16" height="8" rx="1"/>
        <rect x="34" y="72" width="16" height="8" rx="1"/>
        <rect x="54" y="72" width="16" height="8" rx="1"/>
        <rect x="74" y="72" width="16" height="8" rx="1"/>
        <rect x="94" y="72" width="16" height="8" rx="1"/>
        <rect x="114" y="72" width="16" height="8" rx="1"/>
        <rect x="134" y="72" width="16" height="8" rx="1"/>
        <rect x="154" y="72" width="16" height="8" rx="1"/>
        <rect x="174" y="72" width="16" height="8" rx="1"/>
        <rect x="64" y="52" width="72" height="16" rx="2" stroke="#F2C58A" stroke-width="1"/>
      </svg>
    )}

    {v.motif === "frames" && (
      <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.7" aria-hidden="true">
        <rect x="14" y="30" width="50" height="34" rx="2"/>
        <rect x="76" y="40" width="50" height="34" rx="2"/>
        <rect x="138" y="50" width="50" height="34" rx="2" stroke="#7FD7FF" stroke-width="1.3"/>
        <path d="M64 47 L76 57" stroke-dasharray="2,2"/>
        <path d="M126 57 L138 67" stroke-dasharray="2,2"/>
        <circle cx="40"  cy="92" r="2.5" fill="#7FD7FF"/>
        <circle cx="102" cy="92" r="2.5" fill="#7FD7FF"/>
        <circle cx="164" cy="92" r="2.5" fill="#7FD7FF"/>
        <path d="M40 92 L164 92" stroke-dasharray="3,3"/>
      </svg>
    )}

    {v.motif === "stack" && (
      <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
        <rect x="40" y="20" width="120" height="14" rx="2"/>
        <rect x="40" y="38" width="120" height="14" rx="2"/>
        <rect x="40" y="56" width="120" height="14" rx="2" stroke="#B6F5C9" stroke-width="1.2"/>
        <rect x="40" y="74" width="120" height="14" rx="2"/>
        <rect x="40" y="92" width="120" height="14" rx="2"/>
        <circle cx="32" cy="27" r="1.5" fill="#B6F5C9"/>
        <circle cx="32" cy="45" r="1.5" fill="#B6F5C9"/>
        <circle cx="32" cy="63" r="1.5" fill="#B6F5C9"/>
        <circle cx="32" cy="81" r="1.5" fill="#B6F5C9"/>
        <circle cx="32" cy="99" r="1.5" fill="#B6F5C9"/>
      </svg>
    )}

    <div class="pub-thumb-overlay"></div>
    <span class="pub-thumb-code" aria-hidden="true">{itemZh.id.toUpperCase().replace(/-/g, " · ")}</span>
    <span class="pub-thumb-tag" aria-hidden="true">{itemZh.featured ? "OPEN KNOWLEDGE" : "FEATURED"}</span>
  </div>
  <div class="pub-body">
    <h3 class="pub-title">{itemZh.title}</h3>
    <p class="pub-tagline">
      <span data-lang="zh">{itemZh.tagline}</span><span data-lang="en">{itemEn.tagline}</span>
    </p>
    <p class="pub-desc">
      <span data-lang="zh">{itemZh.body}</span><span data-lang="en">{itemEn.body}</span>
    </p>
    <div class="pub-links">
      {itemZh.links.map((l, i) => {
        const enLink = itemEn.links[i];
        const disabled = l.disabled;
        const href = disabled ? undefined : l.href;
        return (
          <a
            class={`pub-link${disabled ? " is-disabled" : ""}`}
            href={href}
            aria-disabled={disabled ? "true" : undefined}
            title={disabled ? "Link coming soon" : undefined}
          >
            <span data-lang="zh">{l.label}</span><span data-lang="en">{enLink.label}</span>
            <span class="pub-link-arrow" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
  </div>
</article>

<style>
  .pub-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(138, 175, 198, 0.05), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 44, 0.86) 0%, rgba(7, 21, 33, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    overflow: hidden;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
  }
  .pub-card:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .pub-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
  }
  .pub-thumb-bg { position: absolute; inset: 0; z-index: -2; }
  .pub-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgba(255, 255, 255, 0.28);
    mix-blend-mode: screen;
    z-index: -1;
    transition: transform 600ms var(--ease-out);
  }
  .pub-card:hover .pub-motif { transform: scale(1.06); }
  .pub-thumb-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 26%, rgba(4, 13, 23, 0.82) 100%),
      linear-gradient(135deg, transparent 58%, rgba(4, 13, 23, 0.28) 100%);
    pointer-events: none;
  }
  .pub-thumb-code {
    position: absolute;
    bottom: 12px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 238, 247, 0.85);
    text-shadow: 0 0 12px rgba(6, 9, 15, 0.8);
    z-index: 1;
  }
  .pub-thumb-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.22em;
    padding: 4px 8px;
    color: rgba(182, 214, 232, 0.84);
    background: rgba(8, 15, 22, 0.56);
    border: 1px solid rgba(162, 192, 210, 0.16);
    border-radius: var(--radius-pill);
    z-index: 1;
    text-transform: uppercase;
  }

  .pub-body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .pub-title { font-size: 18px; letter-spacing: 0.01em; }
  .pub-tagline {
    color: rgba(178, 214, 232, 0.82);
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  .pub-desc { color: rgba(214, 229, 241, 0.72); font-size: 13px; flex-grow: 1; line-height: 1.75; }
  html[lang="en"] .pub-desc { line-height: 1.55; }

  .pub-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(139, 178, 203, 0.11);
    color: rgba(206, 220, 229, 0.68);
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .pub-link:hover {
    border-color: rgba(181, 209, 224, 0.22);
    color: rgba(228, 236, 241, 0.88);
    background: rgba(158, 181, 196, 0.06);
  }
  .pub-link-arrow { transition: transform 160ms var(--ease-out); }
  .pub-link:hover .pub-link-arrow { transform: translateX(3px); }
  .pub-link.is-disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

  /* Featured strip card */
  .pub-card--featured { grid-column: 1 / -1; flex-direction: row; }
  .pub-card--featured .pub-thumb { width: 320px; aspect-ratio: auto; flex-shrink: 0; }
  .pub-card--featured .pub-body { flex: 1; padding: 24px 26px; }
  @media (max-width: 768px) {
    .pub-card--featured { flex-direction: column; }
    .pub-card--featured .pub-thumb { width: 100%; aspect-ratio: 16 / 9; }
    .pub-card--featured .pub-body { padding: 18px; }
  }
</style>
