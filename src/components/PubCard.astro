---
import type { Publication } from "../data/types";
interface Props { itemZh: Publication; itemEn: Publication; }
const { itemZh, itemEn } = Astro.props;

const visuals: Record<string, { from: string; to: string; motif: string }> = {
  vistorybench:        { from: "#5C8DFF", to: "#0B1A2E", motif: "storyboard" },
  styleme3d:           { from: "#9B7BFF", to: "#0B1A2E", motif: "gaussian" },
  shotstudio:          { from: "#F2C58A", to: "#0B1A2E", motif: "filmstrip" },
  act2cut:             { from: "#7FD7FF", to: "#0B1A2E", motif: "frames" },
  "awesome-paperdaily":{ from: "#B6F5C9", to: "#0B1A2E", motif: "stack" },
};
const thumbImages: Record<string, { src: string; height: number }> = {
  act2cut: { src: "/images/act2cut-card.webp?v=1174-page1", height: 699 },
  vistorybench: { src: "/images/vistorybench.webp", height: 696 },
  styleme3d: { src: "/images/styleme3d.webp", height: 595 },
};
const titleIconPaths: Record<string, string[]> = {
  act2cut: ["M3 8h18v12H3z", "M3 8l3-4h15l-3 4", "m7 4 3 4", "m14 4 3 4"],
  vistorybench: ["M3 4h18v16H3z", "M12 4v16", "M3 12h18", "m15 16 1.5 1.5 3-3"],
  styleme3d: ["m12 3 9 5-9 5-9-5 9-5Z", "M3 8v8l9 5 9-5V8", "M12 13v8"],
  shotstudio: ["M3 6h18v14H3z", "M3 10h18", "M7 6v4", "M12 6v4", "M17 6v4", "M8 15h8"],
  "awesome-paperdaily": ["M7 4h12v16H7z", "M4 7v14h12", "M10 9h6", "M10 13h6", "M10 17h4"],
};
const v = visuals[itemZh.id] ?? visuals.vistorybench;
const thumbImage = thumbImages[itemZh.id];
const thumbTag = itemZh.venue ?? (itemZh.featured ? "OPEN KNOWLEDGE" : undefined);
const thumbTitle = itemEn.paperTitle ?? itemZh.title;
const gaussianDots = Array.from({ length: 28 }).map((_, i) => ({
  cx: 30 + (i * 13 + (i * i * 7)) % 150,
  cy: 20 + (i * 9 + i * 11) % 90,
  r: 4 + (i % 6),
  o: 0.15 + (i % 5) * 0.12,
}));
---
<article class="pub-card reveal">
  <span class="card-hover-ring" aria-hidden="true"></span>
  <div class="pub-thumb-shell">
    <div class="pub-thumb" data-expand-thumb>
      <div class="pub-thumb-bg" style={`background: radial-gradient(120% 100% at 20% 0%, ${v.from}33 0%, transparent 60%), linear-gradient(160deg, ${v.from}22 0%, ${v.to} 80%);`}></div>
      {thumbImage && <img class="pub-thumb-image" src={thumbImage.src} alt="" width="760" height={thumbImage.height} loading="lazy" decoding="async" data-expand-image />}

      {!thumbImage && v.motif === "storyboard" && (
        <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
          <rect x="10"  y="14" width="34" height="22" rx="2"/>
          <rect x="50"  y="14" width="34" height="22" rx="2"/>
          <rect x="90"  y="14" width="34" height="22" rx="2"/>
          <rect x="130" y="14" width="34" height="22" rx="2"/>
          <rect x="10"  y="48" width="34" height="22" rx="2"/>
          <rect x="50"  y="48" width="34" height="22" rx="2"/>
          <rect x="90"  y="48" width="34" height="22" rx="2"/>
          <rect x="130" y="48" width="34" height="22" rx="2"/>
          <rect x="10"  y="82" width="34" height="22" rx="2"/>
          <rect x="50"  y="82" width="34" height="22" rx="2" stroke-width="1.4" stroke="#7FD7FF"/>
          <rect x="90"  y="82" width="34" height="22" rx="2"/>
          <rect x="130" y="82" width="34" height="22" rx="2"/>
        </svg>
      )}

      {!thumbImage && v.motif === "gaussian" && (
        <svg class="pub-motif" viewBox="0 0 200 120" fill="none" aria-hidden="true">
          {gaussianDots.map((d) => (
            <circle cx={d.cx} cy={d.cy} r={d.r} fill="#9B7BFF" opacity={d.o}/>
          ))}
        </svg>
      )}

      {!thumbImage && v.motif === "filmstrip" && (
        <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
          <rect x="10" y="36" width="180" height="48" rx="3"/>
          <rect x="14" y="40" width="16" height="8" rx="1"/>
          <rect x="34" y="40" width="16" height="8" rx="1"/>
          <rect x="54" y="40" width="16" height="8" rx="1"/>
          <rect x="74" y="40" width="16" height="8" rx="1"/>
          <rect x="94" y="40" width="16" height="8" rx="1"/>
          <rect x="114" y="40" width="16" height="8" rx="1"/>
          <rect x="134" y="40" width="16" height="8" rx="1"/>
          <rect x="154" y="40" width="16" height="8" rx="1"/>
          <rect x="174" y="40" width="16" height="8" rx="1"/>
          <rect x="14" y="72" width="16" height="8" rx="1"/>
          <rect x="34" y="72" width="16" height="8" rx="1"/>
          <rect x="54" y="72" width="16" height="8" rx="1"/>
          <rect x="74" y="72" width="16" height="8" rx="1"/>
          <rect x="94" y="72" width="16" height="8" rx="1"/>
          <rect x="114" y="72" width="16" height="8" rx="1"/>
          <rect x="134" y="72" width="16" height="8" rx="1"/>
          <rect x="154" y="72" width="16" height="8" rx="1"/>
          <rect x="174" y="72" width="16" height="8" rx="1"/>
          <rect x="64" y="52" width="72" height="16" rx="2" stroke="#F2C58A" stroke-width="1"/>
        </svg>
      )}

      {!thumbImage && v.motif === "frames" && (
        <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.7" aria-hidden="true">
          <rect x="14" y="30" width="50" height="34" rx="2"/>
          <rect x="76" y="40" width="50" height="34" rx="2"/>
          <rect x="138" y="50" width="50" height="34" rx="2" stroke="#7FD7FF" stroke-width="1.3"/>
          <path d="M64 47 L76 57" stroke-dasharray="2,2"/>
          <path d="M126 57 L138 67" stroke-dasharray="2,2"/>
          <circle cx="40"  cy="92" r="2.5" fill="#7FD7FF"/>
          <circle cx="102" cy="92" r="2.5" fill="#7FD7FF"/>
          <circle cx="164" cy="92" r="2.5" fill="#7FD7FF"/>
          <path d="M40 92 L164 92" stroke-dasharray="3,3"/>
        </svg>
      )}

      {!thumbImage && v.motif === "stack" && (
        <svg class="pub-motif" viewBox="0 0 200 120" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true">
          <rect x="40" y="20" width="120" height="14" rx="2"/>
          <rect x="40" y="38" width="120" height="14" rx="2"/>
          <rect x="40" y="56" width="120" height="14" rx="2" stroke="#B6F5C9" stroke-width="1.2"/>
          <rect x="40" y="74" width="120" height="14" rx="2"/>
          <rect x="40" y="92" width="120" height="14" rx="2"/>
          <circle cx="32" cy="27" r="1.5" fill="#B6F5C9"/>
          <circle cx="32" cy="45" r="1.5" fill="#B6F5C9"/>
          <circle cx="32" cy="63" r="1.5" fill="#B6F5C9"/>
          <circle cx="32" cy="81" r="1.5" fill="#B6F5C9"/>
          <circle cx="32" cy="99" r="1.5" fill="#B6F5C9"/>
        </svg>
      )}

      <div class="pub-thumb-overlay"></div>
      <span class="pub-thumb-paper-title">{thumbTitle}</span>
      {thumbTag && <span class="pub-thumb-tag">{thumbTag}</span>}
    </div>
  </div>
  <div class="pub-body">
    <div class="pub-heading">
      <h3 class="pub-title">
        <span class="pub-title-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            {(titleIconPaths[itemZh.id] ?? titleIconPaths["awesome-paperdaily"]).map((path) => <path d={path} />)}
          </svg>
        </span>
        <span class="pub-title-text">{itemZh.title}</span>
      </h3>
      {itemZh.institutions && (
        <p class="pub-institutions">
          <span data-lang="zh">{itemZh.institutions}</span>
          <span data-lang="en">{itemEn.institutions}</span>
        </p>
      )}
    </div>
    {itemZh.venue && (
      <p class="pub-venue">
        <span data-lang="zh">{itemZh.venue}</span>
        <span data-lang="en">{itemEn.venue}</span>
      </p>
    )}
    <p class="pub-tagline">
      <span data-lang="zh">{itemZh.tagline}</span>
      <span data-lang="en">{itemEn.tagline}</span>
    </p>
    <p class="pub-desc">
      <span data-lang="zh">{itemZh.body}</span>
      <span data-lang="en">{itemEn.body}</span>
    </p>
    <div class="pub-links">
      {itemZh.links.map((l, i) => {
        const enLink = itemEn.links[i];
        const disabled = l.disabled;
        const href = disabled ? undefined : l.href;
        return (
          <a
            class={`pub-link${disabled ? " is-disabled" : ""}`}
            href={href}
            aria-disabled={disabled ? "true" : undefined}
            title={disabled ? "Link coming soon" : undefined}
          >
            <span data-lang="zh">{l.label}</span><span data-lang="en">{enLink.label}</span>
            <span class="pub-link-arrow" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
  </div>
</article>

<style>
  .pub-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(138, 175, 198, 0.05), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 44, 0.86) 0%, rgba(7, 21, 33, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    overflow: visible;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
  }
  .pub-card:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .pub-thumb-shell {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: visible;
  }
  .pub-thumb {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    transition:
      height 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 1100ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pub-card:hover .pub-thumb {
    height: var(--thumb-full-height, 100%);
    z-index: 11;
  }
  .pub-thumb-bg { position: absolute; inset: 0; z-index: -2; }
  .pub-thumb-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    z-index: 2;
    display: block;
    transition: filter 1100ms cubic-bezier(0.22, 1, 0.36, 1);
    filter: saturate(1.02) contrast(1.02);
    will-change: filter;
  }
  .pub-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgba(255, 255, 255, 0.28);
    mix-blend-mode: screen;
    z-index: -1;
    transition: transform 600ms var(--ease-out);
  }
  .pub-card:hover .pub-motif { transform: scale(1.06); }
  .pub-card:hover .pub-thumb-image {
    filter: saturate(1.06) contrast(1.05) drop-shadow(0 18px 32px rgba(2, 9, 17, 0.35));
  }
  .pub-thumb-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4, 13, 23, 0.06) 0%, rgba(4, 13, 23, 0.82) 100%),
      linear-gradient(135deg, transparent 52%, rgba(4, 13, 23, 0.34) 100%);
    z-index: 3;
    pointer-events: none;
    transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pub-thumb-paper-title {
    position: absolute;
    bottom: 12px;
    left: 14px;
    max-width: calc(100% - 28px);
    font-family: var(--font-en);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: rgba(241, 246, 251, 0.96);
    text-shadow: 0 0 12px rgba(6, 9, 15, 0.8);
    z-index: 4;
    transition:
      opacity 380ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pub-thumb-tag {
    --glass-small: rgba(24, 22, 17, 0.82);
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-en);
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 4px 8px;
    color: var(--gold-faint);
    background: var(--glass-small);
    border: 1px solid rgba(244, 215, 122, 0.48);
    border-radius: var(--radius-pill);
    z-index: 4;
    transition:
      opacity 380ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pub-card:hover .pub-thumb-overlay,
  .pub-card:hover .pub-thumb-paper-title,
  .pub-card:hover .pub-thumb-tag {
    opacity: 0;
  }
  .pub-card:hover .pub-thumb-paper-title { transform: translateY(6px); }
  .pub-card:hover .pub-thumb-tag { transform: translateY(-6px); }

  .pub-body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .pub-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pub-title { display: flex; align-items: center; flex: 0 1 auto; gap: 8px; max-width: 60%; min-width: 0; font-size: var(--type-medium); letter-spacing: 0.01em; }
  .pub-title-icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 32px; width: 32px; height: 32px; padding: 6px; border: 1px solid rgba(119, 195, 226, 0.17); border-radius: 9px; background: rgba(83, 163, 199, 0.09); color: var(--accent-cyan); }
  .pub-title-icon svg { width: 100%; height: 100%; }
  .pub-title-text { min-width: 0; overflow-wrap: anywhere; }
  .pub-institutions {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-en);
    font-size: var(--type-small);
    line-height: 1.35;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .pub-tagline {
    color: rgba(178, 214, 232, 0.82);
    font-size: var(--type-small);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  .pub-desc { color: rgba(214, 229, 241, 0.72); font-size: var(--type-small); flex-grow: 1; line-height: 1.75; }
  html[lang="en"] .pub-desc { line-height: 1.55; }

  .pub-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.08em;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(139, 178, 203, 0.11);
    color: rgba(206, 220, 229, 0.68);
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .pub-link:hover {
    border-color: rgba(181, 209, 224, 0.22);
    color: rgba(228, 236, 241, 0.88);
    background: rgba(158, 181, 196, 0.06);
  }
  .pub-link-arrow { transition: transform 160ms var(--ease-out); }
  .pub-link:hover .pub-link-arrow { transform: translateX(3px); }
  .pub-link.is-disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

</style>

<script>
  const setupExpandableThumbs = () => {
    const thumbs = document.querySelectorAll("[data-expand-thumb]");

    thumbs.forEach((thumb) => {
      const image = thumb.querySelector("[data-expand-image]");
      if (!(thumb instanceof HTMLElement) || !(image instanceof HTMLImageElement)) return;

      const updateShift = () => {
        const thumbHeight = thumb.clientHeight;
        const imageHeight = image.getBoundingClientRect().height;
        const fullHeight = Math.max(thumbHeight, imageHeight);
        thumb.style.setProperty("--thumb-full-height", `${fullHeight}px`);
      };

      if (image.complete) updateShift();
      image.addEventListener("load", updateShift, { once: true });
      window.addEventListener("resize", updateShift);
      updateShift();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupExpandableThumbs, { once: true });
  } else {
    setupExpandableThumbs();
  }
</script>
