---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";
const z = zh.directions;
const e = en.directions;
const splitBody = (body: string) => {
  const [intro, ...points] = body.trim().split(/\s+(?=\d\.\s)/);
  return {
    intro,
    points: points.map((point) => {
      const [heading, ...details] = point.replace(/^\d\.\s*/, "").split(/\n+/).map((line) => line.trim()).filter(Boolean);
      return { heading, details };
    }),
  };
};
const bodyZh = z.items.map((item) => splitBody(item.body));
const bodyEn = e.items.map((item) => splitBody(item.body));
const directionMark = (id: string) => id === "cgi" ? "CGI" : id === "icn" ? "ICN" : "StarX";
---
<section class="section directions" id="directions" aria-labelledby="directions-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">02</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="directions-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <div class="dir-grid">
      {z.items.map((d, i) => (
        <article class="dir-card reveal">
          <span class="card-hover-ring" aria-hidden="true"></span>
          <span class="dir-card-watermark" aria-hidden="true">
            {directionMark(d.id)}
          </span>
          <div class="dir-copy">
            <header class="dir-head">
              <span class="dir-index" aria-hidden="true">
                <span>{directionMark(d.id)}</span>
                <span class="dir-index-kind">{d.id === "starx" ? "Studio" : "Lab"}</span>
              </span>
              <div class="dir-heading">
                <h3 class="dir-title">
                  <span data-lang="zh">{d.title}</span>
                  <span data-lang="en">{e.items[i].title}</span>
                </h3>
                <div class="dir-logo-wrap" aria-hidden="true">
                  <img class="dir-logo dir-logo--light" src={`/images/logo-${d.id}-lab-light.webp`} alt="" width="1164" height="264" loading="lazy" decoding="async" />
                  <img class="dir-logo dir-logo--dark" src={`/images/logo-${d.id}-lab-dark.webp`} alt="" width="1164" height="264" loading="lazy" decoding="async" />
                </div>
              </div>
            </header>
            <p class="dir-tagline">
              <span class="dir-tagline-decor" aria-hidden="true">»</span>
              <span data-lang="zh">{d.tagline}</span>
              <span data-lang="en">{e.items[i].tagline}</span>
            </p>
            <button class="dir-toggle" type="button" aria-expanded="false" aria-controls={`dir-details-${d.id}`}>
              <span class="dir-toggle-collapsed"><span data-lang="zh">展开正文</span><span data-lang="en">Read More</span></span>
              <span class="dir-toggle-expanded"><span data-lang="zh">收起正文</span><span data-lang="en">Show Less</span></span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 9 7 7 7-7" /></svg>
            </button>
          </div>
          <div class="dir-details" id={`dir-details-${d.id}`} aria-hidden="true">
            <div class="dir-details-inner">
              <div class="dir-intro">
                <p data-lang="zh">{bodyZh[i].intro}</p>
                <p data-lang="en">{bodyEn[i].intro}</p>
              </div>
              <div class="dir-body">
                <div data-lang="zh"><ol>{bodyZh[i].points.map((point) => <li>{point.details.length ? <><strong>{point.heading}</strong>{point.details.map((line) => <span class="dir-point-line">{line}</span>)}</> : point.heading}</li>)}</ol></div>
                <div data-lang="en"><ol>{bodyEn[i].points.map((point) => <li>{point.details.length ? <><strong>{point.heading}</strong>{point.details.map((line) => <span class="dir-point-line">{line}</span>)}</> : point.heading}</li>)}</ol></div>
              </div>
            </div>
          </div>
          <ul class="dir-tags">
            {d.tags.map((t, ti) => (
              <li class="tag">
                <span data-lang="zh">{t}</span>
                <span data-lang="en">{e.items[i].tags[ti]}</span>
              </li>
            ))}
          </ul>
          {d.team && e.items[i].team && (
            <aside class="dir-team" aria-label={d.team.name}>
              <div class="dir-team-logo-wrap" aria-hidden="true">
                <img class="dir-team-logo dir-team-logo--light" src={`${d.team.logoBase}-light.webp`} alt="" width="1200" height="236" loading="lazy" decoding="async" />
                <img class="dir-team-logo dir-team-logo--dark" src={`${d.team.logoBase}-dark.webp`} alt="" width="1200" height="236" loading="lazy" decoding="async" />
              </div>
              {d.team.description && e.items[i].team.description && (
                <p class="dir-team-description">
                  <span data-lang="zh">{d.team.description}</span>
                  <span data-lang="en">{e.items[i].team.description}</span>
                </p>
              )}
            </aside>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(91, 146, 181, 0.055), transparent 34%),
      linear-gradient(180deg, rgba(8, 24, 39, 0.74), rgba(5, 18, 31, 0.86));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: var(--type-small);
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .dir-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 18px; }
  @media (min-width: 861px) {
    .dir-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      column-gap: 36px;
      align-items: start;
    }
    .dir-card:last-child:nth-child(odd) .dir-copy { grid-column: 1 / -1; grid-row: 1; }
    .dir-card:last-child:nth-child(odd) .dir-details { grid-column: 1 / -1; grid-row: 2; }
    .dir-card:last-child:nth-child(odd) .dir-details-inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 36px; }
    .dir-card:last-child:nth-child(odd) .dir-body { margin-top: 0; }
    .dir-card:last-child:nth-child(odd) .dir-tags { grid-column: 1 / -1; grid-row: 3; }
    .dir-card:last-child:nth-child(odd) .dir-team { grid-column: 1 / -1; grid-row: 4; }
  }
  .dir-card {
    position: relative;
    padding: 32px 28px 28px;
    background:
      radial-gradient(140% 120% at 100% 0%, rgba(129, 168, 193, 0.05), transparent 32%),
      linear-gradient(170deg, rgba(10, 29, 47, 0.86) 0%, rgba(7, 21, 35, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
    isolation: isolate;
  }
  .dir-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 18px;
    padding: 1px;
    background: linear-gradient(135deg, transparent 30%, rgba(167, 201, 223, 0.16) 60%, rgba(129, 154, 175, 0.12) 80%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .dir-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 80% 100%, rgba(80, 118, 148, 0.11), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .dir-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-card-hover); border-color: var(--surface-border-strong); }
  .dir-card:hover::before { opacity: 1; }

  .dir-card-watermark {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: var(--font-mono);
    font-size: var(--type-large);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(180, 204, 220, 0.05);
    pointer-events: none;
    user-select: none;
  }

  .dir-head { display: flex; gap: 16px; align-items: center; margin-bottom: 18px; }
  .dir-heading { flex: 1; min-width: 0; }
  .dir-logo-wrap { position: relative; width: 85%; max-width: 350px; aspect-ratio: 1164 / 264; }
  .dir-logo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 180ms ease; }
  .dir-logo--light { opacity: 0; }
  :global(html[data-theme="light"]) .dir-logo--light { opacity: 1; }
  :global(html[data-theme="light"]) .dir-logo--dark { opacity: 0; }
  .dir-index {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-width: 90px;
    font-family: var(--font-mono);
    font-size: var(--type-medium);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.03em;
    padding: 9px 14px;
    border-radius: 8px;
    background: rgba(145, 185, 208, 0.08);
    border: 1px solid rgba(145, 185, 208, 0.16);
    color: rgba(181, 215, 234, 0.86);
    flex-shrink: 0;
  }
  .dir-index-kind { font-size: var(--type-small); font-weight: 500; letter-spacing: 0.06em; }
  .dir-title { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .dir-tagline {
    font-size: var(--type-small);
    color: rgba(177, 214, 233, 0.82);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dir-tagline-decor { font-family: var(--font-mono); font-weight: 700; opacity: 0.7; }
  .dir-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    border: 1px solid rgba(145, 185, 208, 0.3);
    border-radius: var(--radius-pill);
    background: rgba(145, 185, 208, 0.08);
    color: rgba(181, 215, 234, 0.96);
    font: inherit;
    font-size: var(--type-small);
    line-height: 1.4;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .dir-toggle:hover { background: rgba(145, 185, 208, 0.16); border-color: rgba(145, 185, 208, 0.5); }
  .dir-toggle:focus-visible { outline: 2px solid var(--accent-cyan); outline-offset: 3px; }
  .dir-toggle svg { transition: transform 280ms ease; }
  .dir-toggle-expanded { display: none; }
  .dir-card.is-open .dir-toggle-collapsed { display: none; }
  .dir-card.is-open .dir-toggle-expanded { display: inline; }
  .dir-card.is-open .dir-toggle svg { transform: rotate(180deg); }
  .dir-details {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    transition: grid-template-rows 460ms cubic-bezier(0.76, 0, 0.24, 1), margin-top 460ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  .dir-details-inner { min-height: 0; overflow: hidden; }
  .dir-card.is-open .dir-details { grid-template-rows: 1fr; margin-top: 18px; }
  .dir-intro, .dir-body { color: rgba(214, 229, 241, 0.74); font-size: var(--type-small); line-height: 1.8; }
  .dir-body { margin-top: 14px; }
  .dir-body ol { display: grid; gap: 10px; margin: 0; padding-left: 1.5em; }
  .dir-body li { padding-left: 3px; }
  .dir-body li strong { display: block; color: var(--text-primary); font-weight: 600; }
  .dir-point-line { display: block; }
  html[lang="en"] :is(.dir-intro, .dir-body) { line-height: 1.6; }
  .dir-team {
    margin-top: 22px;
    padding: 18px 20px;
    border: 1px solid var(--surface-border-strong);
    border-radius: 14px;
    background: var(--surface);
  }
  .dir-team-logo-wrap { position: relative; width: 100%; max-width: 400px; margin-inline: auto; aspect-ratio: 1200 / 236; }
  .dir-card:last-child .dir-team-logo-wrap { max-width: 580px; }
  .dir-team-logo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 180ms ease; }
  .dir-team-logo--light { opacity: 0; }
  :global(html[data-theme="light"]) .dir-team-logo--light { opacity: 1; }
  :global(html[data-theme="light"]) .dir-team-logo--dark { opacity: 0; }
  .dir-team-description { margin: 10px 0 0; color: var(--text-muted); font-size: var(--type-small); line-height: 1.75; }

  .dir-tags { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: 0.1em;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgba(136, 171, 193, 0.045);
    border: 1px solid rgba(136, 171, 193, 0.12);
    color: rgba(203, 220, 231, 0.72);
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .tag:hover { border-color: rgba(180, 208, 224, 0.2); color: rgba(228, 236, 241, 0.88); background: rgba(163, 184, 198, 0.07); }

  @media (max-width: 860px) {
    .dir-grid { grid-template-columns: 1fr; gap: 18px; }
    .dir-card { padding: 32px 24px; }
    .dir-card-watermark { font-size: var(--type-large); top: 18px; right: 20px; }
    .section-panel { padding: 24px 20px 28px; }
  }
  @media (max-width: 480px) {
    .dir-head { flex-direction: column; align-items: flex-start; gap: 12px; }
    .dir-heading { width: 100%; }
    .dir-index { min-width: 82px; padding: 8px 12px; }
  }
</style>

<script is:inline>
  document.querySelectorAll(".dir-toggle").forEach(function (button) {
    button.addEventListener("click", function () {
      var card = button.closest(".dir-card");
      var details = card.querySelector(".dir-details");
      var open = card.classList.toggle("is-open");
      button.setAttribute("aria-expanded", String(open));
      details.setAttribute("aria-hidden", String(!open));
    });
  });
</script>
