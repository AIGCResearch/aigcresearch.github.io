---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";
const z = zh.directions;
const e = en.directions;
---
<section class="section directions" id="directions" aria-labelledby="directions-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">02</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="directions-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <div class="dir-grid">
      {z.items.map((d, i) => (
        <article class="dir-card reveal">
          <span class="dir-card-watermark" aria-hidden="true">{i === 0 ? "GCI" : "ICW"}</span>
          <header class="dir-head">
            <span class="dir-index">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="dir-title">
                <span data-lang="zh">{d.title}</span><span data-lang="en">{e.items[i].title}</span>
              </h3>
              <p class="dir-subtitle">
                <span data-lang="zh">{d.subtitle}</span><span data-lang="en">{e.items[i].subtitle}</span>
              </p>
            </div>
          </header>
          <p class="dir-tagline">
            <span class="dir-tagline-decor" aria-hidden="true">»</span>
            <span data-lang="zh">{d.tagline}</span><span data-lang="en">{e.items[i].tagline}</span>
          </p>
          <p class="dir-body">
            <span data-lang="zh">{d.body}</span><span data-lang="en">{e.items[i].body}</span>
          </p>
          <ul class="dir-tags">
            {d.tags.map((t, ti) => (
              <li class="tag">
                <span data-lang="zh">{t}</span><span data-lang="en">{e.items[i].tags[ti]}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(91, 146, 181, 0.055), transparent 34%),
      linear-gradient(180deg, rgba(8, 24, 39, 0.74), rgba(5, 18, 31, 0.86));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: 16px;
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .dir-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .dir-card {
    position: relative;
    padding: 32px 28px 28px;
    background:
      radial-gradient(140% 120% at 100% 0%, rgba(129, 168, 193, 0.05), transparent 32%),
      linear-gradient(170deg, rgba(10, 29, 47, 0.86) 0%, rgba(7, 21, 35, 0.94) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.024),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
    isolation: isolate;
  }
  .dir-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 18px;
    padding: 1px;
    background: linear-gradient(135deg, transparent 30%, rgba(167, 201, 223, 0.16) 60%, rgba(129, 154, 175, 0.12) 80%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .dir-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 80% 100%, rgba(80, 118, 148, 0.11), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .dir-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-card-hover); border-color: var(--surface-border-strong); }
  .dir-card:hover::before { opacity: 1; }

  .dir-card-watermark {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: var(--font-mono);
    font-size: 66px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(180, 204, 220, 0.05);
    pointer-events: none;
    user-select: none;
  }

  .dir-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 18px; }
  .dir-index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    padding: 5px 12px;
    border-radius: 6px;
    background: rgba(145, 185, 208, 0.08);
    border: 1px solid rgba(145, 185, 208, 0.16);
    color: rgba(181, 215, 234, 0.86);
    flex-shrink: 0;
  }
  .dir-title { font-size: 24px; letter-spacing: 0.01em; }
  .dir-subtitle { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.2em; color: rgba(200, 220, 236, 0.64); margin-top: 4px; text-transform: uppercase; }

  .dir-tagline {
    font-size: 15px;
    color: rgba(177, 214, 233, 0.82);
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .dir-tagline-decor { font-family: var(--font-mono); font-weight: 700; opacity: 0.7; }
  .dir-body { color: rgba(214, 229, 241, 0.74); font-size: 14px; line-height: 1.8; }
  html[lang="en"] .dir-body { line-height: 1.6; }

  .dir-tags { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgba(136, 171, 193, 0.045);
    border: 1px solid rgba(136, 171, 193, 0.12);
    color: rgba(203, 220, 231, 0.72);
    text-transform: uppercase;
    transition: border-color 160ms var(--ease-out), color 160ms var(--ease-out), background 160ms var(--ease-out);
  }
  .tag:hover { border-color: rgba(180, 208, 224, 0.2); color: rgba(228, 236, 241, 0.88); background: rgba(163, 184, 198, 0.07); }

  @media (max-width: 860px) {
    .dir-grid { grid-template-columns: 1fr; gap: 18px; }
    .dir-card { padding: 32px 24px; }
    .dir-card-watermark { font-size: 56px; top: 18px; right: 20px; }
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
