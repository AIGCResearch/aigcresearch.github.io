---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";

const z = zh.philosophy;
const e = en.philosophy;
const iconMap: Record<string, string> = {
  film: "M3 3h18v18H3V3zm0 4h18M3 11h18M3 15h18M3 19h18M7 3v18M17 3v18",
  compass: "M12 2L8 12l4 10 4-10-4-10zM2 12h20",
  workflow: "M4 6h6v6H4V6zm10 6h6v6h-6v-6zm-4 0h4M14 9V6m0 0h6v6",
};
---
<section class="section philosophy" id="philosophy" aria-labelledby="philosophy-title">
  <hr class="section-divider" />
  <div class="container">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">01</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="philosophy-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <ul class="pillars">
      {z.pillars.map((p, i) => (
        <li class="pillar reveal">
          <span class="pillar-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconMap[p.icon] ?? "M12 2L2 22h20L12 2z"}></path>
            </svg>
          </span>
          <h3 class="pillar-title">
            <span data-lang="zh">{p.title}</span><span data-lang="en">{e.pillars[i].title}</span>
          </h3>
          <p class="pillar-body">
            <span data-lang="zh">{p.body}</span><span data-lang="en">{e.pillars[i].body}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lede {
    max-width: 760px;
    color: var(--text-muted);
    font-size: 17px;
    margin-top: 20px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .pillar {
    position: relative;
    padding: 36px 28px 32px;
    background:
      linear-gradient(180deg, rgba(18, 32, 56, 0.7) 0%, rgba(11, 26, 46, 0.55) 100%);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-card);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-card);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
    isolation: isolate;
  }
  .pillar::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(127, 215, 255, 0.10), transparent 70%);
    z-index: -1;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .pillar::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
    opacity: 0.3;
    transition: opacity 280ms var(--ease-out);
  }
  .pillar:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }
  .pillar:hover::before { opacity: 1; }
  .pillar:hover::after { opacity: 0.9; }

  .pillar-num {
    position: absolute;
    top: 18px;
    right: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }
  .pillar-icon {
    display: inline-flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background:
      linear-gradient(135deg, rgba(92, 141, 255, 0.18), rgba(155, 123, 255, 0.10));
    border: 1px solid var(--surface-border-strong);
    color: var(--accent-cyan);
    margin-bottom: 22px;
    box-shadow: inset 0 0 22px rgba(127, 215, 255, 0.08);
  }
  .pillar-title { margin-bottom: 10px; font-size: 20px; letter-spacing: 0.01em; }
  .pillar-body { color: var(--text-muted); font-size: 15px; line-height: 1.8; }
  html[lang="en"] .pillar-body { line-height: 1.6; }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: 1fr; gap: 18px; }
    .pillar { padding: 28px 24px; }
  }
</style>
