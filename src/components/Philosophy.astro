---
import { zh } from "../data/content.zh";
import { en } from "../data/content.en";

const z = zh.philosophy;
const e = en.philosophy;
const iconMap: Record<string, string> = {
  film: "M3 3h18v18H3V3zm0 4h18M3 11h18M3 15h18M3 19h18M7 3v18M17 3v18",
  compass: "M12 2L8 12l4 10 4-10-4-10zM2 12h20",
  workflow: "M4 6h6v6H4V6zm10 6h6v6h-6v-6zm-4 0h4M14 9V6m0 0h6v6",
};
---
<section class="section philosophy" id="philosophy" aria-labelledby="philosophy-title">
  <hr class="section-divider" />
  <div class="container section-panel">
    <header class="section-head">
      <div class="section-chapter">
        <span class="section-chapter-tick"></span>
        <span class="section-chapter-num">01</span>
        <span>Chapter</span>
      </div>
      <div class="section-head-body">
        <p class="eyebrow reveal"><span data-lang="zh">{z.eyebrow}</span><span data-lang="en">{e.eyebrow}</span></p>
        <h2 class="section-title reveal" id="philosophy-title">
          <span data-lang="zh">{z.title}</span><span data-lang="en">{e.title}</span>
        </h2>
        <p class="lede reveal">
          <span data-lang="zh">{z.intro}</span><span data-lang="en">{e.intro}</span>
        </p>
      </div>
    </header>

    <ul class="pillars">
      {z.pillars.map((p, i) => (
        <li class="pillar reveal">
          <span class="pillar-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="pillar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconMap[p.icon] ?? "M12 2L2 22h20L12 2z"}></path>
            </svg>
          </span>
          <h3 class="pillar-title">
            <span data-lang="zh">{p.title}</span><span data-lang="en">{e.pillars[i].title}</span>
          </h3>
          <p class="pillar-body">
            <span data-lang="zh">{p.body}</span><span data-lang="en">{e.pillars[i].body}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-panel {
    padding: 34px 34px 38px;
    border-radius: 26px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(92, 154, 194, 0.06), transparent 38%),
      linear-gradient(180deg, rgba(8, 24, 39, 0.72), rgba(5, 18, 31, 0.84));
    border: 1px solid rgba(145, 187, 214, 0.1);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(214, 229, 239, 0.035),
      inset 0 -24px 40px rgba(1, 8, 15, 0.18),
      0 22px 54px rgba(2, 9, 17, 0.3);
  }
  .lede {
    max-width: 860px;
    color: rgba(220, 233, 243, 0.78);
    font-size: 16px;
    margin-top: 18px;
    line-height: 1.85;
  }
  html[lang="en"] .lede { line-height: 1.65; }

  .pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .pillar {
    position: relative;
    padding: 28px 24px 24px;
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(143, 184, 210, 0.055), transparent 34%),
      linear-gradient(180deg, rgba(10, 28, 45, 0.84) 0%, rgba(7, 21, 35, 0.92) 100%);
    border: 1px solid rgba(139, 178, 203, 0.09);
    border-radius: 18px;
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 0 rgba(226, 235, 241, 0.025),
      0 16px 36px rgba(2, 9, 17, 0.26);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
    overflow: hidden;
    isolation: isolate;
  }
  .pillar::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(145, 189, 218, 0.08), transparent 70%);
    z-index: -1;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .pillar::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(189, 214, 229, 0.24), transparent);
    opacity: 0.6;
    transition: opacity 280ms var(--ease-out);
  }
  .pillar:hover {
    transform: translateY(-8px);
    border-color: var(--surface-border-strong);
    box-shadow: var(--shadow-card-hover);
  }
  .pillar:hover::before { opacity: 1; }
  .pillar:hover::after { opacity: 0.9; }

  .pillar-num {
    position: absolute;
    top: 16px;
    right: 18px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--text-dim);
  }
  .pillar-icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background:
      linear-gradient(135deg, rgba(145, 179, 201, 0.12), rgba(84, 112, 134, 0.06));
    border: 1px solid rgba(155, 189, 212, 0.16);
    color: rgba(168, 208, 231, 0.88);
    margin-bottom: 18px;
    box-shadow: inset 0 0 18px rgba(204, 220, 230, 0.03);
  }
  .pillar-title { margin-bottom: 8px; font-size: 19px; letter-spacing: 0.01em; }
  .pillar-body { color: rgba(214, 229, 241, 0.72); font-size: 14px; line-height: 1.8; }
  html[lang="en"] .pillar-body { line-height: 1.6; }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: 1fr; gap: 18px; }
    .pillar { padding: 28px 24px; }
    .section-panel { padding: 24px 20px 28px; }
  }
</style>
